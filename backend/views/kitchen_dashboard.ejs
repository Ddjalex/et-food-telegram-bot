<!-- Toast container -->
<div id="toastContainer"></div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    // ── GLOBALS ──────────────────────────────────────────────────
    let allMenuItems = [];
    let allProducts  = [];
    let currentFilter        = 'all';
    let currentCategory      = 'all';
    let currentProductCategory = 'all';
    let currentOrderFilter   = 'all';
    let soundEnabled = true;
    let knownOrderIds = new Set();
    let audioCtx = null;

    // ── DATE LINE ────────────────────────────────────────────────
    (function() {
        const d = new Date();
        const opts = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
        document.getElementById('todayDateLine').textContent =
            'Today is ' + d.toLocaleDateString('en-US', opts) + '.';
    })();

    // ── LIVE CLOCK ───────────────────────────────────────────────
    function updateClock() {
        const el = document.getElementById('liveClock');
        if (el) el.textContent = new Date().toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
    }
    setInterval(updateClock, 1000);
    updateClock();

    // ── PANEL SWITCHER ───────────────────────────────────────────
    function switchPanel(name, btnEl) {
        document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
        document.querySelectorAll('.nav-tab').forEach(b => b.classList.remove('active'));
        document.getElementById('panel-' + name).classList.add('active');
        if (btnEl) btnEl.classList.add('active');
    }

    // ── SOUND ────────────────────────────────────────────────────
    function getAudioCtx() {
        if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        return audioCtx;
    }
    function playNewOrderSound() {
        if (!soundEnabled) return;
        try {
            const ctx = getAudioCtx();
            [880, 1047, 1319].forEach((freq, i) => {
                const osc = ctx.createOscillator(), gain = ctx.createGain();
                osc.type = 'sine'; osc.frequency.value = freq;
                gain.gain.setValueAtTime(0, ctx.currentTime + i*0.18);
                gain.gain.linearRampToValueAtTime(0.35, ctx.currentTime + i*0.18 + 0.05);
                gain.gain.linearRampToValueAtTime(0, ctx.currentTime + i*0.18 + 0.22);
                osc.connect(gain); gain.connect(ctx.destination);
                osc.start(ctx.currentTime + i*0.18); osc.stop(ctx.currentTime + i*0.18 + 0.25);
            });
        } catch(e) {}
    }
    function toggleSound() {
        soundEnabled = !soundEnabled;
        const btn = document.getElementById('soundToggleBtn');
        const lbl = document.getElementById('soundLabel');
        if (soundEnabled) {
            btn.classList.add('sound-on'); lbl.textContent = 'Sound ON';
            btn.querySelector('i').className = 'fas fa-volume-up';
        } else {
            btn.classList.remove('sound-on'); lbl.textContent = 'Sound OFF';
            btn.querySelector('i').className = 'fas fa-volume-mute';
        }
    }

    // ── TOAST ────────────────────────────────────────────────────
    function showToast(message, type = 'info', duration = 4000) {
        const icons = { success: '✅', error: '❌', warning: '⚠️', info: 'ℹ️', order: '🔔' };
        const container = document.getElementById('toastContainer');
        const toast = document.createElement('div');
        toast.className = `kitchen-toast toast-${type}`;
        toast.innerHTML = `
            <span class="toast-icon">${icons[type] || icons.info}</span>
            <span class="toast-msg">${message}</span>
            <span class="toast-close" onclick="this.parentElement.remove()">✕</span>`;
        container.appendChild(toast);
        setTimeout(() => { if (toast.parentElement) { toast.style.opacity='0'; toast.style.transition='opacity 0.4s'; setTimeout(()=>toast.remove(),400); } }, duration);
    }

    function flashScreen() {
        const flash = document.createElement('div');
        flash.className = 'new-order-flash';
        document.body.appendChild(flash);
        setTimeout(() => flash.remove(), 800);
    }

    // ── LOGOUT ───────────────────────────────────────────────────
    async function logout() {
        try {
            await fetch('/kitchen/logout', { method: 'POST' });
        } catch(e) {}
        window.location.href = '/kitchen/login';
    }

    // ── ORDER FILTER ─────────────────────────────────────────────
    function setOrderFilter(filter, el) {
        currentOrderFilter = filter;
        document.querySelectorAll('#orderFilterPills .filter-pill').forEach(t => t.classList.remove('active'));
        el.classList.add('active');
        loadOrders();
    }

    // ── STATUS HELPERS ───────────────────────────────────────────
    function statusBadge(status) {
        const map = {
            pending:           ['bs-pending',   'Pending'],
            kitchen_confirmed: ['bs-confirmed',  'Confirmed'],
            confirmed:         ['bs-confirmed',  'Confirmed'],
            preparing:         ['bs-preparing',  'Preparing'],
            ready:             ['bs-ready',      'Ready'],
            delivered:         ['bs-delivered',  'Delivered'],
            cancelled:         ['bs-cancelled',  'Cancelled'],
        };
        const [cls, label] = map[status] || ['bs-pending', status];
        return `<span class="badge-status ${cls}"><span class="s-dot"></span>${label}</span>`;
    }
    function payBadge(payStatus) {
        if (!payStatus || payStatus === 'pending') return `<span class="badge-pay bp-pending"><span class="s-dot"></span>Not Paid</span>`;
        return `<span class="badge-pay bp-verified"><span class="s-dot"></span>Paid</span>`;
    }
    function timeAgo(dateStr) {
        const diff = Math.floor((Date.now() - new Date(dateStr)) / 60000);
        if (diff < 1) return 'just now';
        if (diff < 60) return `${diff}m ago`;
        return `${Math.floor(diff/60)}h ${diff%60}m ago`;
    }
    function timeClass(dateStr) {
        const diff = Math.floor((Date.now() - new Date(dateStr)) / 60000);
        if (diff > 30) return 'time-urgent';
        if (diff > 15) return 'time-warn';
        return '';
    }

    // ── LOAD & RENDER ORDERS ─────────────────────────────────────
    document.addEventListener('DOMContentLoaded', function() {
        loadOrders();
        loadStatistics();
        loadMenuItems();
        loadCategories();
        loadProducts();
        loadProductCategories();
        setupFileUpload();
        setInterval(loadOrders,      5000);
        setInterval(loadStatistics, 15000);
        setInterval(loadMenuItems,  60000);
        setInterval(loadProducts,   60000);
    });

    async function loadOrders() {
        try {
            const response = await fetch('/api/kitchen/orders');
            const data = await response.json();
            const orders = data.orders || data;
            const activeStatuses = ['pending','kitchen_confirmed','confirmed','preparing','ready'];
            const incoming = orders.filter(o => activeStatuses.includes(o.status));

            let hasNew = false;
            incoming.forEach(o => {
                if (!knownOrderIds.has(o.id)) {
                    if (knownOrderIds.size > 0) {
                        hasNew = true;
                        showToast(`New order #${(o.order_number||o.id).toString().slice(-6).toUpperCase()} from ${o.customer_name}`, 'order', 6000);
                    }
                    knownOrderIds.add(o.id);
                }
            });
            if (hasNew) { playNewOrderSound(); flashScreen(); }

            const now = new Date();
            document.getElementById('lastRefreshed').textContent =
                `Updated ${now.toLocaleTimeString('en-US',{hour:'2-digit',minute:'2-digit'})}`;

            renderOrdersTable(incoming);
        } catch(e) {
            document.getElementById('ordersContainer').innerHTML =
                `<div class="empty-state"><div class="es-icon">⚠️</div><h3>Connection Error</h3><p>Could not load orders. Check your connection.</p></div>`;
        }
    }

    function renderOrdersTable(orders) {
        const container = document.getElementById('ordersContainer');
        let filtered = orders;
        if (currentOrderFilter !== 'all') {
            filtered = orders.filter(o => o.status === currentOrderFilter ||
                (currentOrderFilter === 'kitchen_confirmed' && o.status === 'confirmed'));
        }

        if (filtered.length === 0) {
            container.innerHTML = `<div class="empty-state">
                <div class="es-icon">📋</div>
                <h3>No orders found</h3>
                <p>No ${currentOrderFilter !== 'all' ? currentOrderFilter : 'active'} orders right now.</p>
            </div>`;
            return;
        }

        const rows = filtered.map(order => {
            const items = Array.isArray(order.items) ? order.items : [];
            const itemsText = items.map(i => `${i.name || i.item_name || 'Item'} ×${i.quantity||1}`).join(', ') || '—';
            const itemsCount = items.reduce((s, i) => s + (i.quantity||1), 0);
            const isUrgent = timeClass(order.created_at) === 'time-urgent';

            return `<tr class="${isUrgent ? 'urgent-row' : ''}">
                <td><span class="order-id-cell">#${(order.order_number||order.id).toString().slice(-6).toUpperCase()}</span></td>
                <td>
                    <div class="customer-cell">${order.customer_name || '—'}</div>
                    <div class="customer-phone">${order.customer_phone || ''}</div>
                </td>
                <td><span class="time-cell ${timeClass(order.created_at)}">${timeAgo(order.created_at)}</span></td>
                <td>${statusBadge(order.status)}</td>
                <td>${payBadge(order.payment_status)}</td>
                <td><span class="items-cell" title="${itemsText}">${itemsCount} item${itemsCount!==1?'s':''}</span></td>
                <td><span class="total-cell">${parseFloat(order.total_amount||0).toFixed(0)} ETB</span></td>
                <td class="actions-cell">${renderOrderActions(order)}</td>
            </tr>`;
        }).join('');

        container.innerHTML = `
            <div class="orders-table-wrap">
                <table class="orders-table">
                    <thead>
                        <tr>
                            <th>Order ID</th>
                            <th>Customer</th>
                            <th>Time</th>
                            <th>Order Status</th>
                            <th>Payment</th>
                            <th>Items</th>
                            <th>Total</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>${rows}</tbody>
                </table>
            </div>`;
    }

    function renderOrderActions(order) {
        const s = order.status;
        let btns = '';
        if (s === 'pending') {
            btns += `<button class="btn-outline-sm" onclick="updateOrderStatus('${order.id}','kitchen_confirmed')">
                <i class="fas fa-check"></i> Accept</button>`;
            btns += `<button class="btn-danger-sm" onclick="rejectOrder('${order.id}')">
                <i class="fas fa-times"></i> Reject</button>`;
        } else if (s === 'kitchen_confirmed' || s === 'confirmed') {
            btns += `<button class="btn-outline-sm" onclick="updateOrderStatus('${order.id}','preparing')">
                <i class="fas fa-fire"></i> Start Cooking</button>`;
        } else if (s === 'preparing') {
            btns += `<button class="btn-primary-action" style="font-size:0.8rem;padding:5px 12px;" onclick="updateOrderStatus('${order.id}','ready')">
                <i class="fas fa-check-double"></i> Mark Ready</button>`;
        } else if (s === 'ready') {
            btns += `<span style="font-size:0.78rem;color:#059669;font-weight:600;"><i class="fas fa-check-circle me-1"></i>Awaiting Driver</span>`;
        }
        return `<div class="btn-group">${btns}</div>`;
    }

    // ── ORDER STATUS UPDATE ───────────────────────────────────────
    async function updateOrderStatus(orderId, newStatus) {
        try {
            const res = await fetch(`/api/kitchen/orders/${orderId}/status`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ status: newStatus })
            });
            const result = await res.json();
            if (result.success) {
                const labels = { kitchen_confirmed:'Order confirmed', preparing:'Cooking started', ready:'Order ready!' };
                showToast(labels[newStatus] || 'Status updated', 'success');
                loadOrders(); loadStatistics();
            } else {
                showToast('Failed: ' + (result.error||'Unknown error'), 'error');
            }
        } catch(e) {
            showToast('Network error. Please try again.', 'error');
        }
    }

    async function rejectOrder(orderId) {
        if (!confirm('Reject this order? The customer will be notified.')) return;
        try {
            const res = await fetch(`/api/kitchen/orders/${orderId}/status`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ status: 'unavailable' })
            });
            const result = await res.json();
            if (result.success) {
                showToast('Order marked as unavailable. Customer notified.', 'warning');
                loadOrders(); loadStatistics();
            } else {
                showToast('Failed: ' + (result.error||'Unknown error'), 'error');
            }
        } catch(e) {
            showToast('Network error. Please try again.', 'error');
        }
    }

    // ── STATISTICS ───────────────────────────────────────────────
    async function loadStatistics() {
        try {
            const res = await fetch('/api/orders');
            const data = await res.json();
            if (data.success && data.orders) {
                const stats = calculateStatistics(data.orders);
                updateStatisticsDisplay(stats);
            }
        } catch(e) {}
    }
    function calculateStatistics(orders) {
        const today = new Date().toISOString().split('T')[0];
        let s = { pending:0, preparing:0, ready:0, todayRevenue:0 };
        orders.forEach(o => {
            if (o.status === 'pending') s.pending++;
            else if (o.status === 'preparing') s.preparing++;
            else if (o.status === 'ready') s.ready++;
            if (new Date(o.created_at).toISOString().split('T')[0] === today)
                s.todayRevenue += parseFloat(o.total_amount||0);
        });
        return s;
    }
    function updateStatisticsDisplay(stats) {
        document.getElementById('pendingOrders').textContent  = stats.pending;
        document.getElementById('preparingOrders').textContent = stats.preparing;
        document.getElementById('readyOrders').textContent    = stats.ready;
        document.getElementById('todayRevenue').textContent   = stats.todayRevenue.toFixed(0) + ' ETB';
    }

    // ── MENU AVAILABILITY ────────────────────────────────────────
    async function loadMenuItems() {
        try {
            const res  = await fetch('/api/kitchen/menu-items');
            const data = await res.json();
            if (data.items) { allMenuItems = data.items; displayMenuItems(); loadCategories(); }
            else throw new Error();
        } catch(e) {
            document.getElementById('menuItemsContainer').innerHTML =
                `<div class="empty-state"><div class="es-icon">⚠️</div><h3>Error Loading Menu</h3><p>Check your connection and try again.</p></div>`;
        }
    }

    async function loadCategories() {
        const cats = [...new Set(allMenuItems.map(i => i.category).filter(Boolean))];
        const bar = document.getElementById('categoryFilter');
        bar.innerHTML = `<button class="cat-btn active" data-category="all" onclick="filterByCategory('all')">All</button>`;
        cats.forEach(c => {
            const b = document.createElement('button');
            b.className = 'cat-btn'; b.dataset.category = c;
            b.onclick = () => filterByCategory(c); b.textContent = c;
            bar.appendChild(b);
        });
    }

    function displayMenuItems() {
        const container = document.getElementById('menuItemsContainer');
        let items = allMenuItems;
        if (currentFilter === 'available')   items = items.filter(i => i.available);
        if (currentFilter === 'unavailable') items = items.filter(i => !i.available);
        if (currentCategory !== 'all')       items = items.filter(i => i.category === currentCategory);

        if (!items.length) {
            container.innerHTML = `<div class="empty-state"><div class="es-icon">🍽️</div><h3>No Items Found</h3><p>No items match the current filter.</p></div>`;
            return;
        }
        container.innerHTML = '';
        const grid = document.createElement('div');
        grid.className = 'menu-grid';
        items.forEach(item => grid.appendChild(createMenuItemCard(item)));
        container.appendChild(grid);
    }

    function createMenuItemCard(item) {
        const div = document.createElement('div');
        div.className = `menu-item-row${item.available ? '' : ' unavailable'}`;
        div.innerHTML = `
            <img src="${item.image_url||'/static/placeholder-food.jpg'}" alt="${item.name}" class="menu-img"
                 onerror="this.src='/static/placeholder-food.jpg'">
            <div class="menu-info">
                <div class="menu-name">${item.name}</div>
                <div class="menu-cat">${item.category||''}</div>
                <div class="menu-price">${item.price} ETB</div>
            </div>
            <div class="toggle-wrap">
                <div class="toggle-sw${item.available ? ' on' : ''}"
                     onclick="toggleItemAvailability('${item.id}', ${!item.available})"></div>
            </div>`;
        return div;
    }

    async function toggleItemAvailability(itemId, available) {
        try {
            const res = await fetch('/api/kitchen/toggle-availability', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ item_id: itemId, available, reason: available ? 'Kitchen available' : 'Kitchen unavailable' })
            });
            const result = await res.json();
            if (result.success) {
                const idx = allMenuItems.findIndex(i => i.id === itemId);
                if (idx !== -1) allMenuItems[idx].available = available;
                displayMenuItems();
            } else { showToast('Failed: ' + result.error, 'error'); }
        } catch(e) { showToast('Network error. Try again.', 'error'); }
    }

    function showAvailabilityTab(filter, btnEl) {
        currentFilter = filter;
        document.querySelectorAll('#availabilityPills .filter-pill').forEach(b => b.classList.remove('active'));
        if (btnEl) btnEl.classList.add('active');
        displayMenuItems();
    }

    function filterByCategory(category) {
        currentCategory = category;
        document.querySelectorAll('#categoryFilter .cat-btn').forEach(b => b.classList.remove('active'));
        const t = document.querySelector(`#categoryFilter [data-category="${category}"]`);
        if (t) t.classList.add('active');
        displayMenuItems();
    }

    async function markAllAvailable() {
        if (!confirm('Mark ALL menu items as available?')) return;
        try {
            const res = await fetch('/api/kitchen/bulk-update-availability', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ action: 'mark_all_available' })
            });
            const r = await res.json();
            if (r.success) { loadMenuItems(); showToast('All items marked available', 'success'); }
            else showToast('Failed: ' + r.error, 'error');
        } catch(e) { showToast('Network error. Try again.', 'error'); }
    }

    async function markAllUnavailable() {
        if (!confirm('Mark ALL menu items as unavailable?')) return;
        try {
            const res = await fetch('/api/kitchen/bulk-update-availability', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ action: 'mark_all_unavailable' })
            });
            const r = await res.json();
            if (r.success) { loadMenuItems(); showToast('All items marked unavailable', 'warning'); }
            else showToast('Failed: ' + r.error, 'error');
        } catch(e) { showToast('Network error. Try again.', 'error'); }
    }

    async function markCategoryUnavailable() {
        const cats = [...new Set(allMenuItems.map(i => i.category))];
        const cat = prompt(`Enter category name to mark unavailable:\n${cats.join(', ')}`);
        if (!cat || !cats.includes(cat)) { showToast('Invalid category', 'warning'); return; }
        if (!confirm(`Mark all items in "${cat}" as unavailable?`)) return;
        try {
            const res = await fetch('/api/kitchen/bulk-update-availability', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ action: 'mark_category_unavailable', category: cat })
            });
            const r = await res.json();
            if (r.success) { loadMenuItems(); showToast('Category marked unavailable', 'warning'); }
            else showToast('Failed: ' + r.error, 'error');
        } catch(e) { showToast('Network error. Try again.', 'error'); }
    }

    // ── PRODUCTS ─────────────────────────────────────────────────
    async function loadProducts() {
        try {
            const res  = await fetch('/api/kitchen/menu-items');
            const data = await res.json();
            if (data.items) { allProducts = data.items; displayProducts(); updateProductCategories(); }
            else throw new Error();
        } catch(e) {
            document.getElementById('productsContainer').innerHTML =
                `<div class="empty-state"><div class="es-icon">⚠️</div><h3>Error Loading Products</h3><p>Check connection and try again.</p></div>`;
        }
    }

    function displayProducts() {
        const container = document.getElementById('productsContainer');
        let items = allProducts;
        if (currentProductCategory !== 'all') items = items.filter(p => p.category === currentProductCategory);

        if (!items.length) {
            container.innerHTML = `<div class="empty-state"><div class="es-icon">📦</div><h3>No Products Found</h3><p>No products match the filter.</p></div>`;
            return;
        }
        const grid = document.createElement('div');
        grid.className = 'products-grid';
        items.forEach(p => grid.appendChild(createProductCard(p)));
        container.innerHTML = '';
        container.appendChild(grid);
    }

    function createProductCard(product) {
        const div = document.createElement('div');
        div.className = 'product-card';
        div.innerHTML = `
            <img src="${product.image_url||'/static/placeholder-food.jpg'}" alt="${product.name}"
                 class="product-thumb" onerror="this.src='/static/placeholder-food.jpg'">
            <div class="product-body">
                <div class="product-name-p">${product.name}</div>
                <div class="product-cat-p">${product.category||''}</div>
                <div class="product-desc-p">${product.description||'No description'}</div>
                <div class="product-price-p">${product.price} ETB</div>
                <div class="product-foot">
                    <button class="btn-outline-sm" onclick="editProduct('${product.id}')"><i class="fas fa-edit me-1"></i>Edit</button>
                    <button class="btn-outline-sm" onclick="updatePrice('${product.id}')"><i class="fas fa-tag me-1"></i>Price</button>
                    <button class="btn-danger-sm" onclick="deleteProduct('${product.id}')"><i class="fas fa-trash"></i></button>
                </div>
            </div>`;
        return div;
    }

    function updateProductCategories() {
        const cats = [...new Set(allProducts.map(p => p.category).filter(Boolean))];
        const bar = document.getElementById('productCategoryFilter');
        bar.innerHTML = `<button class="cat-btn active" data-category="all" onclick="filterProductsByCategory('all')">All</button>`;
        cats.forEach(c => {
            const b = document.createElement('button');
            b.className = 'cat-btn'; b.dataset.category = c;
            b.onclick = () => filterProductsByCategory(c); b.textContent = c;
            bar.appendChild(b);
        });
    }

    function filterProductsByCategory(cat) {
        currentProductCategory = cat;
        document.querySelectorAll('#productCategoryFilter .cat-btn').forEach(b => b.classList.remove('active'));
        const t = document.querySelector(`#productCategoryFilter [data-category="${cat}"]`);
        if (t) t.classList.add('active');
        displayProducts();
    }

    function showAddProductModal() {
        document.getElementById('productModalTitle').textContent = 'Add New Product';
        document.getElementById('productForm').reset();
        document.getElementById('productId').value = '';
        document.getElementById('imagePreview').style.display = 'none';
        loadProductCategories();
        document.getElementById('productModal').classList.add('show');
    }

    function editProduct(productId) {
        const product = allProducts.find(p => p.id == productId);
        if (!product) return;
        document.getElementById('productModalTitle').textContent = 'Edit Product';
        document.getElementById('productId').value = product.id;
        document.getElementById('productName').value = product.name;
        document.getElementById('productDescription').value = product.description || '';
        document.getElementById('productPrice').value = product.price;
        loadProductCategories().then(() => {
            document.getElementById('productCategory').value = product.category;
        });
        if (product.image_url) {
            document.getElementById('imagePreview').src = product.image_url;
            document.getElementById('imagePreview').style.display = 'block';
        }
        document.getElementById('productModal').classList.add('show');
    }

    function updatePrice(productId) {
        const product = allProducts.find(p => p.id == productId);
        if (!product) return;
        document.getElementById('priceProductId').value   = product.id;
        document.getElementById('priceProductName').value = product.name;
        document.getElementById('currentPrice').value     = product.price;
        document.getElementById('newPrice').value         = product.price;
        document.getElementById('priceModal').classList.add('show');
    }

    async function deleteProduct(productId) {
        const product = allProducts.find(p => p.id == productId);
        if (!product) return;
        if (!confirm(`Delete "${product.name}"? This cannot be undone.`)) return;
        try {
            const res = await fetch(`/api/kitchen/products/${productId}`, { method: 'DELETE' });
            const r = await res.json();
            if (r.success) { showToast('Product deleted', 'success'); loadProducts(); }
            else showToast('Failed to delete: ' + r.error, 'error');
        } catch(e) { showToast('Error deleting. Try again.', 'error'); }
    }

    function closeProductModal() { document.getElementById('productModal').classList.remove('show'); }
    function closePriceModal()   { document.getElementById('priceModal').classList.remove('show');   }

    async function loadProductCategories() {
        try {
            const res  = await fetch('/api/kitchen/categories');
            const data = await res.json();
            const sel = document.getElementById('productCategory');
            sel.innerHTML = '<option value="">Select Category</option>';
            if (data.categories) {
                data.categories.forEach(c => {
                    const opt = document.createElement('option');
                    opt.value = c.name; opt.textContent = c.name;
                    sel.appendChild(opt);
                });
            }
        } catch(e) {}
    }

    // ── PRODUCT FORM SUBMIT ───────────────────────────────────────
    document.getElementById('productForm').addEventListener('submit', async function(e) {
        e.preventDefault();
        const productId = document.getElementById('productId').value;
        const isEdit = !!productId;
        const formData = new FormData(this);
        try {
            const url = isEdit ? `/api/kitchen/products/${productId}` : '/api/kitchen/products';
            const method = isEdit ? 'PUT' : 'POST';
            const res = await fetch(url, { method, body: formData });
            const r = await res.json();
            if (r.success) {
                showToast(isEdit ? 'Product updated!' : 'Product added!', 'success');
                closeProductModal(); loadProducts();
            } else { showToast('Failed: ' + (r.error||'Unknown error'), 'error'); }
        } catch(err) { showToast('Network error. Try again.', 'error'); }
    });

    // ── PRICE FORM SUBMIT ─────────────────────────────────────────
    document.getElementById('priceForm').addEventListener('submit', async function(e) {
        e.preventDefault();
        const productId = document.getElementById('priceProductId').value;
        const newPrice  = document.getElementById('newPrice').value;
        try {
            const res = await fetch(`/api/kitchen/products/${productId}/price`, {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ price: newPrice })
            });
            const r = await res.json();
            if (r.success) { showToast('Price updated!', 'success'); closePriceModal(); loadProducts(); }
            else showToast('Failed: ' + (r.error||'Unknown error'), 'error');
        } catch(err) { showToast('Network error. Try again.', 'error'); }
    });

    // ── FILE UPLOAD ───────────────────────────────────────────────
    function setupFileUpload() {
        const area  = document.getElementById('fileUploadArea');
        const input = document.getElementById('productImage');
        const prev  = document.getElementById('imagePreview');

        area.addEventListener('click', () => input.click());
        area.addEventListener('dragover', e => { e.preventDefault(); area.classList.add('dragover'); });
        area.addEventListener('dragleave', () => area.classList.remove('dragover'));
        area.addEventListener('drop', e => {
            e.preventDefault(); area.classList.remove('dragover');
            if (e.dataTransfer.files[0]) { input.files = e.dataTransfer.files; showPreview(e.dataTransfer.files[0]); }
        });
        input.addEventListener('change', () => { if (input.files[0]) showPreview(input.files[0]); });

        function showPreview(file) {
            const reader = new FileReader();
            reader.onload = ev => { prev.src = ev.target.result; prev.style.display = 'block'; };
            reader.readAsDataURL(file);
        }
    }

    // Close modals on overlay click
    document.querySelectorAll('.modal-overlay').forEach(overlay => {
        overlay.addEventListener('click', e => { if (e.target === overlay) overlay.classList.remove('show'); });
    });
</script>
</body>
</html>
