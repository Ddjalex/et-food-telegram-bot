        async function toggleItemAvailability(itemId, available) {
            try {
                const response = await fetch('/api/kitchen/toggle-availability', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ 
                        item_id: itemId, 
                        available: available,
                        reason: available ? 'Kitchen available' : 'Kitchen unavailable'
                    })
                });
                
                const result = await response.json();
                if (result.success) {
                    // Update the item in our local array
                    const itemIndex = allMenuItems.findIndex(item => item.id === itemId);
                    if (itemIndex !== -1) {
                        allMenuItems[itemIndex].available = available;
                    }
                    
                    displayMenuItems();
                } else {
                    showToast('Failed: ' + result.error, 'error');
                }
            } catch (error) {
                console.error('Error toggling availability:', error);
                showToast('Network error. Try again.', 'error');
            }
        }
        
