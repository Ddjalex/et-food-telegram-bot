        async function loadStatistics() {
            try {
                const response = await fetch('/api/orders');
                const data = await response.json();
                
                if (data.success && data.orders) {
                    const stats = calculateStatistics(data.orders);
                    updateStatisticsDisplay(stats);
                } else {
                    console.error('Error loading statistics: Invalid response format');
                }
            } catch (error) {
                console.error('Error loading statistics:', error);
            }
        }
        
        function calculateStatistics(orders) {
            const stats = {
                pending: 0,
                preparing: 0,
                ready: 0,
                todayRevenue: 0
            };
            
            const today = new Date().toISOString().split('T')[0];
            
            orders.forEach(order => {
                switch (order.status) {
                    case 'pending':
                        stats.pending++;
                        break;
                    case 'preparing':
                        stats.preparing++;
                        break;
                    case 'ready':
                        stats.ready++;
                        break;
                }
                
                const orderDate = new Date(order.created_at).toISOString().split('T')[0];
                if (orderDate === today) {
                    stats.todayRevenue += order.total_amount;
                }
            });
            
            return stats;
        }
        
        function updateStatisticsDisplay(stats) {
            document.getElementById('pendingOrders').textContent = stats.pending;
            document.getElementById('preparingOrders').textContent = stats.preparing;
            document.getElementById('readyOrders').textContent = stats.ready;
            document.getElementById('todayRevenue').textContent = stats.todayRevenue.toFixed(0) + ' ETB';
        }
        
