        function createMenuItemCard(item) {
            const card = document.createElement('div');
            card.className = `menu-item-card ${item.available ? 'available' : 'unavailable'}`;
            
            card.innerHTML = `
                <img src="${item.image_url || '/static/placeholder-food.jpg'}" 
                     alt="${item.name}" 
                     class="item-image" 
                     onerror="this.src='/static/placeholder-food.jpg'">
                
                <div class="item-info">
                    <div class="item-name">${item.name}</div>
