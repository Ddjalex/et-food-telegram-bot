<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kitchen Dashboard<% if (restaurant) { %> - <%= restaurant.name %><% } %> - ET-FOOD</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        * {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        }
        
        body {
            background: linear-gradient(135deg, #1e293b 0%, #334155 50%, #475569 100%);
            min-height: 100vh;
            color: #f8fafc;
            margin: 0;
            padding: 0;
        }
        
        .kitchen-navbar {
            background: rgba(15, 23, 42, 0.95);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(59, 130, 246, 0.3);
            padding: 1rem 0;
            position: sticky;
            top: 0;
            z-index: 1000;
        }
        
        .kitchen-navbar .navbar-brand {
            font-size: 1.5rem;
            font-weight: 700;
            color: #3b82f6;
            text-decoration: none;
        }
        
        .kitchen-navbar .navbar-text {
            color: #94a3b8;
            font-size: 0.9rem;
        }
        
        .dashboard-container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 2rem;
        }
        
        .dashboard-header {
            text-align: center;
            margin-bottom: 3rem;
        }
        
        .dashboard-header h1 {
            font-size: 2.5rem;
            font-weight: 700;
            background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin-bottom: 0.5rem;
        }
        
        .dashboard-header p {
            font-size: 1.1rem;
            color: #94a3b8;
            margin-bottom: 0;
        }
        
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 1.5rem;
            margin-bottom: 3rem;
        }
        
        .stat-card {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(59, 130, 246, 0.2);
            border-radius: 16px;
            padding: 1.5rem;
            text-align: center;
            transition: all 0.3s ease;
            backdrop-filter: blur(10px);
            position: relative;
            overflow: hidden;
        }
        
        .stat-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);
        }
        
        .stat-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(59, 130, 246, 0.2);
            background: rgba(255, 255, 255, 0.08);
        }
        
        .stat-card .icon {
            font-size: 2.5rem;
            margin-bottom: 1rem;
            color: #3b82f6;
        }
        
        .stat-card .value {
            font-size: 2rem;
            font-weight: 700;
            color: #f8fafc;
            margin-bottom: 0.5rem;
        }
        
        .stat-card .label {
            font-size: 0.9rem;
            color: #94a3b8;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        
        .orders-section {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(59, 130, 246, 0.2);
            border-radius: 16px;
            padding: 2rem;
            backdrop-filter: blur(10px);
        }
        
        .section-header {
            display: flex;
            justify-content: between;
            align-items: center;
            margin-bottom: 1.5rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid rgba(59, 130, 246, 0.2);
        }
        
        .section-header h2 {
            font-size: 1.5rem;
            font-weight: 600;
            color: #f8fafc;
            margin: 0;
        }
        
        .refresh-btn {
            background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);
            border: none;
            color: white;
            padding: 0.5rem 1rem;
            border-radius: 8px;
            font-size: 0.9rem;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        
        .refresh-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 15px rgba(59, 130, 246, 0.3);
        }
        
        .orders-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 1.5rem;
        }
        
        .order-card {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(59, 130, 246, 0.15);
            border-radius: 12px;
            padding: 1.5rem;
            transition: all 0.3s ease;
            position: relative;
        }
        
        .order-card:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 20px rgba(59, 130, 246, 0.15);
        }
        
        .order-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1rem;
        }
        
        .order-id {
            font-size: 1.1rem;
            font-weight: 600;
            color: #3b82f6;
        }
        
        .order-time {
            font-size: 0.85rem;
            color: #94a3b8;
        }
        
        .order-customer {
            font-size: 1rem;
            color: #f8fafc;
            margin-bottom: 0.5rem;
        }
        
        .order-total {
            font-size: 1.1rem;
            font-weight: 600;
            color: #10b981;
            margin-bottom: 1rem;
        }
        
        .order-status {
            display: inline-block;
            padding: 0.25rem 0.75rem;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        
        .status-pending {
            background: rgba(245, 158, 11, 0.2);
            color: #fbbf24;
            border: 1px solid rgba(245, 158, 11, 0.3);
        }
        
        .status-confirmed {
            background: rgba(59, 130, 246, 0.2);
            color: #3b82f6;
            border: 1px solid rgba(59, 130, 246, 0.3);
        }
        
        .status-preparing {
            background: rgba(139, 92, 246, 0.2);
            color: #8b5cf6;
            border: 1px solid rgba(139, 92, 246, 0.3);
        }
        
        .status-ready {
            background: rgba(16, 185, 129, 0.2);
            color: #10b981;
            border: 1px solid rgba(16, 185, 129, 0.3);
        }
        
        .order-actions {
            display: flex;
            gap: 0.5rem;
            margin-top: 1rem;
        }
        
        .action-btn {
            flex: 1;
            padding: 0.5rem;
            border: none;
            border-radius: 8px;
            font-size: 0.85rem;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        
        .btn-primary {
            background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);
            color: white;
        }
        
        .btn-success {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            color: white;
        }
        
        .btn-warning {
            background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
            color: white;
        }
        
        .btn-danger {
            background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
            color: white;
        }
        
        .action-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
        }
        
        .loading-spinner {
            text-align: center;
            padding: 2rem;
            color: #94a3b8;
        }
        
        .empty-state {
            text-align: center;
            padding: 3rem;
            color: #94a3b8;
        }
        
        .empty-state .icon {
            font-size: 3rem;
            margin-bottom: 1rem;
            color: #475569;
        }

        /* ── KANBAN COLUMNS ── */
        .kanban-board {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 1.2rem;
            align-items: start;
        }
        .kanban-col {
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 14px;
            padding: 1rem;
            min-height: 200px;
        }
        .kanban-col-header {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.85rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            padding-bottom: 10px;
            border-bottom: 2px solid;
            margin-bottom: 12px;
        }
        .col-pending   .kanban-col-header { color:#fbbf24; border-color:#fbbf24; }
        .col-confirmed .kanban-col-header { color:#60a5fa; border-color:#60a5fa; }
        .col-preparing .kanban-col-header { color:#a78bfa; border-color:#a78bfa; }
        .col-ready     .kanban-col-header { color:#34d399; border-color:#34d399; }
        .kanban-count {
            background: rgba(255,255,255,0.12);
            border-radius: 20px;
            padding: 1px 9px;
            font-size: 0.78rem;
            margin-left: auto;
        }
        .kanban-empty {
            color: #475569;
            font-size: 0.82rem;
            text-align: center;
            padding: 1.5rem 0;
        }

        /* ── ORDER CARD ENHANCED ── */
        .order-card {
            position: relative;
            border-left: 3px solid transparent;
        }
        .order-card.urgent {
            border-left-color: #ef4444;
            animation: urgentPulse 2s ease-in-out infinite;
        }
        @keyframes urgentPulse {
            0%,100% { box-shadow: 0 0 0 0 rgba(239,68,68,0); }
            50% { box-shadow: 0 0 0 5px rgba(239,68,68,0.15); }
        }
        .order-card.warning-age { border-left-color: #f59e0b; }
        .order-time.time-ok    { color: #34d399; }
        .order-time.time-warn  { color: #fbbf24; }
        .order-time.time-urgent{ color: #f87171; font-weight: 700; }
        .order-items-list {
            margin: 8px 0 10px;
            padding: 8px 10px;
            background: rgba(255,255,255,0.04);
            border-radius: 8px;
            font-size: 0.82rem;
            color: #cbd5e1;
            line-height: 1.7;
        }
        .order-items-list .item-row {
            display: flex;
            justify-content: space-between;
        }
        .order-items-list .item-qty {
            background: rgba(59,130,246,0.2);
            color: #93c5fd;
            border-radius: 4px;
            padding: 0 5px;
            font-weight: 600;
            font-size: 0.75rem;
        }
        .order-badges {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
            margin-bottom: 8px;
        }
        .badge-payment {
            font-size: 0.72rem;
            padding: 2px 8px;
            border-radius: 10px;
            background: rgba(99,102,241,0.2);
            color: #a5b4fc;
            border: 1px solid rgba(99,102,241,0.3);
        }
        .badge-items-count {
            font-size: 0.72rem;
            padding: 2px 8px;
            border-radius: 10px;
            background: rgba(16,185,129,0.15);
            color: #6ee7b7;
            border: 1px solid rgba(16,185,129,0.25);
        }
        .order-address {
            font-size: 0.78rem;
            color: #64748b;
            margin-bottom: 6px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        /* ── TOAST NOTIFICATIONS ── */
        #toastContainer {
            position: fixed;
            top: 80px;
            right: 20px;
            z-index: 9999;
            display: flex;
            flex-direction: column;
            gap: 10px;
            pointer-events: none;
        }
        .kitchen-toast {
            background: rgba(15,23,42,0.96);
            border: 1px solid rgba(59,130,246,0.3);
            border-radius: 12px;
            padding: 14px 18px;
            color: #f8fafc;
            font-size: 0.9rem;
            min-width: 280px;
            max-width: 360px;
            display: flex;
            align-items: center;
            gap: 12px;
            box-shadow: 0 8px 30px rgba(0,0,0,0.4);
            backdrop-filter: blur(12px);
            pointer-events: all;
            animation: toastIn 0.35s ease;
        }
        .kitchen-toast.toast-success { border-color: rgba(16,185,129,0.5); }
        .kitchen-toast.toast-error   { border-color: rgba(239,68,68,0.5); }
        .kitchen-toast.toast-warning { border-color: rgba(245,158,11,0.5); }
        .kitchen-toast .toast-icon   { font-size: 1.3rem; flex-shrink: 0; }
        .kitchen-toast .toast-msg    { flex: 1; line-height: 1.4; }
        .kitchen-toast .toast-close  { cursor: pointer; color: #64748b; font-size: 1.1rem; flex-shrink: 0; }
        .kitchen-toast .toast-close:hover { color: #f8fafc; }
        @keyframes toastIn {
            from { opacity:0; transform: translateX(30px); }
            to   { opacity:1; transform: translateX(0); }
        }

        /* ── SOUND + CLOCK IN NAVBAR ── */
        .sound-toggle-btn {
            background: rgba(255,255,255,0.08);
            border: 1px solid rgba(255,255,255,0.15);
            color: #94a3b8;
            border-radius: 8px;
            padding: 5px 12px;
            font-size: 0.85rem;
            cursor: pointer;
            transition: all 0.2s;
            margin-right: 8px;
        }
        .sound-toggle-btn.sound-on { color: #34d399; border-color: rgba(52,211,153,0.4); background: rgba(52,211,153,0.1); }
        .live-clock {
            font-size: 0.95rem;
            font-weight: 700;
            color: #60a5fa;
            margin-right: 12px;
            font-variant-numeric: tabular-nums;
        }

        /* ── NEW ORDER FLASH ── */
        .new-order-flash {
            position: fixed;
            inset: 0;
            background: rgba(251,191,36,0.08);
            pointer-events: none;
            z-index: 8000;
            animation: flashFade 0.6s ease forwards;
        }
        @keyframes flashFade { from { opacity:1; } to { opacity:0; } }

        /* ── STATUS FILTER TABS ── */
        .order-filter-tabs {
            display: flex;
            gap: 8px;
            margin-bottom: 1.2rem;
            flex-wrap: wrap;
        }
        .order-filter-tab {
            padding: 5px 14px;
            border-radius: 20px;
            border: 1px solid rgba(255,255,255,0.1);
            background: rgba(255,255,255,0.05);
            color: #94a3b8;
            font-size: 0.82rem;
            cursor: pointer;
            transition: all 0.2s;
        }
        .order-filter-tab.active, .order-filter-tab:hover {
            background: rgba(59,130,246,0.15);
            border-color: rgba(59,130,246,0.4);
            color: #93c5fd;
        }
        
        @media (max-width: 1100px) {
            .kanban-board { grid-template-columns: repeat(2, 1fr); }
        }
        @media (max-width: 768px) {
            .dashboard-container { padding: 1rem; }
            .stats-grid { grid-template-columns: repeat(2, 1fr); }
            .kanban-board { grid-template-columns: 1fr; }
        }
        
        .dashboard-card p {
            font-size: 1rem;
            opacity: 0.8;
            margin-bottom: 20px;
        }
        
        .dashboard-card .btn {
            background: linear-gradient(45deg, #ff6b6b, #ffa726);
            color: white;
            border: none;
            padding: 12px 25px;
            border-radius: 25px;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.3s ease;
        }
        
        .dashboard-card .btn:hover {
            transform: scale(1.05);
            box-shadow: 0 5px 15px rgba(255, 107, 107, 0.3);
        }
        
        .quick-actions {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 20px;
            padding: 30px;
            margin-bottom: 30px;
        }
        
        .quick-actions h3 {
            text-align: center;
            margin-bottom: 25px;
            font-size: 1.8rem;
        }
        
        .action-buttons {
            display: flex;
            flex-wrap: wrap;
            gap: 15px;
            justify-content: center;
        }
        
        /* Food Availability System Styles */
        .availability-section {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(59, 130, 246, 0.2);
            border-radius: 16px;
            padding: 2rem;
            margin-bottom: 2rem;
            backdrop-filter: blur(10px);
        }
        
        .availability-tabs {
            display: flex;
            gap: 1rem;
            margin-bottom: 2rem;
            border-bottom: 1px solid rgba(59, 130, 246, 0.2);
            padding-bottom: 1rem;
        }
        
        .tab-btn {
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(59, 130, 246, 0.3);
            color: #94a3b8;
            padding: 0.75rem 1.5rem;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.3s ease;
            font-weight: 500;
        }
        
        .tab-btn.active, .tab-btn:hover {
            background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);
            color: white;
            border-color: #3b82f6;
        }
        
        .menu-item-card {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(59, 130, 246, 0.15);
            border-radius: 12px;
            padding: 1.5rem;
            margin-bottom: 1rem;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 1rem;
        }
        
        .menu-item-card:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 20px rgba(59, 130, 246, 0.15);
        }
        
        .menu-item-card.unavailable {
            border-color: rgba(239, 68, 68, 0.3);
            background: rgba(239, 68, 68, 0.05);
        }
        
        .menu-item-card.available {
            border-color: rgba(16, 185, 129, 0.3);
            background: rgba(16, 185, 129, 0.05);
        }
        
        .item-image {
            width: 60px;
            height: 60px;
            border-radius: 8px;
            object-fit: cover;
            flex-shrink: 0;
        }
        
        .item-info {
            flex: 1;
        }
        
        .item-name {
            font-size: 1.1rem;
            font-weight: 600;
            color: #f8fafc;
            margin-bottom: 0.25rem;
        }
        
        .item-category {
            font-size: 0.85rem;
            color: #94a3b8;
            margin-bottom: 0.25rem;
        }
        
        .item-price {
            font-size: 1rem;
            font-weight: 600;
            color: #10b981;
        }
        
        .availability-toggle {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        
        .toggle-switch {
            position: relative;
            width: 50px;
            height: 24px;
            background: #64748b;
            border-radius: 24px;
            cursor: pointer;
            transition: background 0.3s ease;
        }
        
        .toggle-switch.active {
            background: #10b981;
        }
        
        .toggle-switch::before {
            content: '';
            position: absolute;
            width: 20px;
            height: 20px;
            background: white;
            border-radius: 50%;
            top: 2px;
            left: 2px;
            transition: transform 0.3s ease;
        }
        
        .toggle-switch.active::before {
            transform: translateX(26px);
        }
        
        .availability-status {
            font-size: 0.85rem;
            font-weight: 600;
            padding: 0.25rem 0.75rem;
            border-radius: 20px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        
        .status-available {
            background: rgba(16, 185, 129, 0.2);
            color: #10b981;
            border: 1px solid rgba(16, 185, 129, 0.3);
        }
        
        .status-unavailable {
            background: rgba(239, 68, 68, 0.2);
            color: #ef4444;
            border: 1px solid rgba(239, 68, 68, 0.3);
        }
        
        .bulk-actions {
            display: flex;
            gap: 1rem;
            margin-bottom: 2rem;
            flex-wrap: wrap;
        }
        
        .bulk-btn {
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(59, 130, 246, 0.3);
            color: #94a3b8;
            padding: 0.75rem 1.5rem;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.3s ease;
            font-weight: 500;
        }
        
        .bulk-btn:hover {
            background: rgba(59, 130, 246, 0.2);
            color: #3b82f6;
            border-color: #3b82f6;
        }
        
        .category-filter {
            display: flex;
            gap: 0.5rem;
            margin-bottom: 1.5rem;
            flex-wrap: wrap;
        }
        
        .filter-btn {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(59, 130, 246, 0.2);
            color: #94a3b8;
            padding: 0.5rem 1rem;
            border-radius: 20px;
            cursor: pointer;
            transition: all 0.3s ease;
            font-size: 0.85rem;
        }
        
        .filter-btn.active, .filter-btn:hover {
            background: rgba(59, 130, 246, 0.2);
            color: #3b82f6;
            border-color: #3b82f6;
        }
        
        /* Food Product Management Styles */
        .product-management-section {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(139, 92, 246, 0.2);
            border-radius: 16px;
            padding: 2rem;
            margin-bottom: 2rem;
            backdrop-filter: blur(10px);
        }
        
        .product-card {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(139, 92, 246, 0.15);
            border-radius: 12px;
            padding: 1.5rem;
            margin-bottom: 1rem;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 1rem;
        }
        
        .product-card:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 20px rgba(139, 92, 246, 0.15);
        }
        
        .product-image {
            width: 80px;
            height: 80px;
            border-radius: 8px;
            object-fit: cover;
            flex-shrink: 0;
        }
        
        .product-info {
            flex: 1;
        }
        
        .product-name {
            font-size: 1.2rem;
            font-weight: 600;
            color: #f8fafc;
            margin-bottom: 0.25rem;
        }
        
        .product-category {
            font-size: 0.85rem;
            color: #94a3b8;
            margin-bottom: 0.25rem;
        }
        
        .product-description {
            font-size: 0.9rem;
            color: #cbd5e1;
            margin-bottom: 0.5rem;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
        
        .product-price {
            font-size: 1.2rem;
            font-weight: 700;
            color: #10b981;
            margin-bottom: 0.5rem;
        }
        
        .product-actions {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
        }
        
        .product-btn {
            padding: 0.5rem 1rem;
            border: none;
            border-radius: 6px;
            font-size: 0.85rem;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 0.25rem;
        }
        
        .btn-edit {
            background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
            color: white;
        }
        
        .btn-delete {
            background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
            color: white;
        }
        
        .btn-price {
            background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
            color: white;
        }
        
        .product-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
        }
        
        .add-product-btn {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            color: white;
            border: none;
            padding: 1rem 2rem;
            border-radius: 12px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            margin-bottom: 2rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        
        .add-product-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(16, 185, 129, 0.3);
        }
        
        /* Modal Styles */
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.8);
            z-index: 1000;
            backdrop-filter: blur(5px);
        }
        
        .modal.show {
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        .modal-content {
            background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
            border: 1px solid rgba(139, 92, 246, 0.3);
            border-radius: 16px;
            padding: 2rem;
            max-width: 600px;
            width: 90%;
            max-height: 90vh;
            overflow-y: auto;
            position: relative;
        }
        
        .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid rgba(139, 92, 246, 0.2);
        }
        
        .modal-title {
            font-size: 1.5rem;
            font-weight: 600;
            color: #f8fafc;
        }
        
        .close-btn {
            background: none;
            border: none;
            color: #94a3b8;
            font-size: 1.5rem;
            cursor: pointer;
            transition: color 0.3s ease;
        }
        
        .close-btn:hover {
            color: #f8fafc;
        }
        
        .form-group {
            margin-bottom: 1.5rem;
        }
        
        .form-label {
            display: block;
            font-size: 0.9rem;
            font-weight: 500;
            color: #f8fafc;
            margin-bottom: 0.5rem;
        }
        
        .form-input, .form-select, .form-textarea {
            width: 100%;
            padding: 0.75rem;
            border: 1px solid rgba(139, 92, 246, 0.3);
            border-radius: 8px;
            background: rgba(255, 255, 255, 0.05);
            color: #f8fafc;
            font-size: 0.9rem;
            transition: all 0.3s ease;
        }
        
        .form-input:focus, .form-select:focus, .form-textarea:focus {
            outline: none;
            border-color: #8b5cf6;
            box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.1);
        }
        
        .form-textarea {
            resize: vertical;
            min-height: 80px;
        }
        
        .file-upload-area {
            border: 2px dashed rgba(139, 92, 246, 0.3);
            border-radius: 8px;
            padding: 2rem;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        
        .file-upload-area:hover {
            border-color: #8b5cf6;
            background: rgba(139, 92, 246, 0.05);
        }
        
        .file-upload-area.dragover {
            border-color: #8b5cf6;
            background: rgba(139, 92, 246, 0.1);
        }
        
        .upload-icon {
            font-size: 2rem;
            color: #8b5cf6;
            margin-bottom: 1rem;
        }
        
        .upload-text {
            color: #94a3b8;
            font-size: 0.9rem;
        }
        
        .image-preview {
            max-width: 200px;
            max-height: 150px;
            border-radius: 8px;
            margin-top: 1rem;
        }
        
        .form-actions {
            display: flex;
            gap: 1rem;
            justify-content: flex-end;
            padding-top: 2rem;
            border-top: 1px solid rgba(139, 92, 246, 0.2);
        }
        
        .btn-modal {
            padding: 0.75rem 1.5rem;
            border: none;
            border-radius: 8px;
            font-size: 0.9rem;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        
        .btn-cancel {
            background: rgba(255, 255, 255, 0.1);
            color: #94a3b8;
            border: 1px solid rgba(255, 255, 255, 0.2);
        }
        
        .btn-save {
            background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%);
            color: white;
        }
        
        .btn-modal:hover {
            transform: translateY(-1px);
        }
        
        .price-input-group {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        
        .currency-label {
            background: rgba(139, 92, 246, 0.2);
            color: #8b5cf6;
            padding: 0.75rem 1rem;
            border-radius: 8px 0 0 8px;
            border: 1px solid rgba(139, 92, 246, 0.3);
            font-weight: 600;
        }
        
        .price-input {
            border-radius: 0 8px 8px 0 !important;
        }
        
        .action-btn {
            background: rgba(255, 255, 255, 0.2);
            border: 1px solid rgba(255, 255, 255, 0.3);
            color: white;
            padding: 12px 20px;
            border-radius: 15px;
            text-decoration: none;
            font-weight: 500;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .action-btn:hover {
            background: rgba(255, 255, 255, 0.3);
            transform: translateY(-2px);
            color: white;
        }
        
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-top: 30px;
        }
        
        .stat-card {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 15px;
            padding: 20px;
            text-align: center;
        }
        
        .stat-card .number {
            font-size: 2.5rem;
            font-weight: 700;
            color: #ffd700;
            margin-bottom: 10px;
        }
        
        .stat-card .label {
            font-size: 1rem;
            opacity: 0.8;
        }
        
        @media (max-width: 768px) {
            .dashboard-cards {
                grid-template-columns: 1fr;
            }
            
            .dashboard-header h1 {
                font-size: 2rem;
            }
            
            .action-buttons {
                flex-direction: column;
                align-items: center;
            }
            
            .action-btn {
                width: 100%;
                justify-content: center;
            }
        }
    </style>
</head>
<body>
    <!-- Navigation Bar -->
    <nav class="kitchen-navbar">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center">
                <a href="/kitchen" class="navbar-brand">
                    <i class="fas fa-utensils me-2"></i>
                    Kitchen Dashboard
                </a>
                <div class="d-flex align-items-center">
                    <span class="live-clock" id="liveClock"></span>
                    <button class="sound-toggle-btn sound-on" id="soundToggleBtn" onclick="toggleSound()" title="Toggle order alert sound">
                        <i class="fas fa-volume-up me-1"></i><span id="soundLabel">Sound ON</span>
                    </button>
                    <div class="navbar-text me-3">
                        <i class="fas fa-store me-1"></i>
                        <% if (restaurant) { %><%= restaurant.name %><% } else { %>Kitchen Staff<% } %>
                    </div>
                    <button class="btn btn-outline-light btn-sm" onclick="logout()" title="Logout">
                        <i class="fas fa-sign-out-alt me-1"></i>Logout
                    </button>
                </div>
            </div>
        </div>
    </nav>

    <div class="dashboard-container">
        <!-- Header -->
        <div class="dashboard-header">
            <h1>Professional Kitchen Management</h1>
            <p>Streamline your restaurant operations with real-time order management and analytics</p>
        </div>
        
        <!-- Statistics Cards -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="icon">
                    <i class="fas fa-clock"></i>
                </div>
                <div class="value" id="pendingOrders">0</div>
                <div class="label">Pending Orders</div>
            </div>
            
            <div class="stat-card">
                <div class="icon">
                    <i class="fas fa-fire"></i>
                </div>
                <div class="value" id="preparingOrders">0</div>
                <div class="label">Preparing</div>
            </div>
            
            <div class="stat-card">
                <div class="icon">
                    <i class="fas fa-check-circle"></i>
                </div>
                <div class="value" id="readyOrders">0</div>
                <div class="label">Ready</div>
            </div>
            
            <div class="stat-card">
                <div class="icon">
                    <i class="fas fa-chart-line"></i>
                </div>
                <div class="value" id="todayRevenue">0</div>
                <div class="label">Today Revenue</div>
            </div>
        </div>
        
        <!-- Food Availability Management Section -->
        <div class="availability-section">
            <div class="section-header">
                <h2>
                    <i class="fas fa-toggle-on me-2"></i>
                    Food Availability Management
                </h2>
                <button class="refresh-btn" onclick="loadMenuItems()">
                    <i class="fas fa-sync-alt me-1"></i>
                    Refresh
                </button>
            </div>
            
            <!-- Availability Tabs -->
            <div class="availability-tabs">
                <button class="tab-btn active" onclick="showAvailabilityTab('all')">
                    <i class="fas fa-list me-1"></i>
                    All Items
                </button>
                <button class="tab-btn" onclick="showAvailabilityTab('available')">
                    <i class="fas fa-check-circle me-1"></i>
                    Available
                </button>
                <button class="tab-btn" onclick="showAvailabilityTab('unavailable')">
                    <i class="fas fa-times-circle me-1"></i>
                    Unavailable
                </button>
            </div>
            
            <!-- Bulk Actions -->
            <div class="bulk-actions">
                <button class="bulk-btn" onclick="markAllAvailable()">
                    <i class="fas fa-check-double me-1"></i>
                    Mark All Available
                </button>
                <button class="bulk-btn" onclick="markAllUnavailable()">
                    <i class="fas fa-ban me-1"></i>
                    Mark All Unavailable
                </button>
                <button class="bulk-btn" onclick="markCategoryUnavailable()">
                    <i class="fas fa-layer-group me-1"></i>
                    Mark Category Unavailable
                </button>
            </div>
            
            <!-- Category Filter -->
            <div class="category-filter" id="categoryFilter">
                <button class="filter-btn active" data-category="all">All Categories</button>
            </div>
            
            <!-- Menu Items Container -->
            <div id="menuItemsContainer">
                <div class="loading-spinner">
                    <i class="fas fa-spinner fa-spin fa-2x"></i>
                    <p>Loading menu items...</p>
                </div>
            </div>
        </div>
        
        <!-- Food Product Management Section -->
        <div class="product-management-section">
            <div class="section-header">
                <h2>
                    <i class="fas fa-utensils me-2"></i>
                    Food Product Management
                </h2>
                <button class="refresh-btn" onclick="loadProducts()">
                    <i class="fas fa-sync-alt me-1"></i>
                    Refresh
                </button>
            </div>
            
            <button class="add-product-btn" onclick="showAddProductModal()">
                <i class="fas fa-plus me-1"></i>
                Add New Product
            </button>
            
            <!-- Category Filter for Products -->
            <div class="category-filter" id="productCategoryFilter">
                <button class="filter-btn active" data-category="all" onclick="filterProductsByCategory('all')">All Categories</button>
            </div>
            
            <!-- Products Container -->
            <div id="productsContainer">
                <div class="loading-spinner">
                    <i class="fas fa-spinner fa-spin fa-2x"></i>
                    <p>Loading products...</p>
                </div>
            </div>
        </div>
        
        <!-- Orders Section -->
        <div class="orders-section">
            <div class="section-header">
                <h2>
                    <i class="fas fa-columns me-2"></i>
                    Live Orders Board
                </h2>
                <div class="d-flex align-items-center gap-2">
                    <span id="lastRefreshed" style="font-size:0.78rem;color:#64748b;"></span>
                    <button class="refresh-btn" onclick="loadOrders()">
                        <i class="fas fa-sync-alt me-1"></i>Refresh
                    </button>
                </div>
            </div>

            <!-- Status filter tabs -->
            <div class="order-filter-tabs" id="orderFilterTabs">
                <span class="order-filter-tab active" data-filter="all" onclick="setOrderFilter('all', this)">All</span>
                <span class="order-filter-tab" data-filter="pending" onclick="setOrderFilter('pending', this)">🟡 Pending</span>
                <span class="order-filter-tab" data-filter="kitchen_confirmed" onclick="setOrderFilter('kitchen_confirmed', this)">🔵 Confirmed</span>
                <span class="order-filter-tab" data-filter="preparing" onclick="setOrderFilter('preparing', this)">🟣 Preparing</span>
                <span class="order-filter-tab" data-filter="ready" onclick="setOrderFilter('ready', this)">🟢 Ready</span>
            </div>
            
            <div id="ordersContainer">
                <div class="loading-spinner">
                    <i class="fas fa-spinner fa-spin fa-2x"></i>
                    <p>Loading orders...</p>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Product Management Modals -->
    <!-- Add/Edit Product Modal -->
    <div id="productModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title" id="productModalTitle">Add New Product</h2>
                <button class="close-btn" onclick="closeProductModal()">&times;</button>
            </div>
            
            <form id="productForm" enctype="multipart/form-data">
                <input type="hidden" id="productId" name="productId">
                
                <div class="form-group">
                    <label class="form-label" for="productName">Product Name *</label>
                    <input type="text" id="productName" name="name" class="form-input" required>
                </div>
                
                <div class="form-group">
                    <label class="form-label" for="productCategory">Category *</label>
                    <select id="productCategory" name="category" class="form-select" required>
                        <option value="">Select Category</option>
                    </select>
                </div>
                
                <div class="form-group">
                    <label class="form-label" for="productDescription">Description</label>
                    <textarea id="productDescription" name="description" class="form-textarea" placeholder="Enter product description..."></textarea>
                </div>
                
                <div class="form-group">
                    <label class="form-label" for="productPrice">Price *</label>
                    <div class="price-input-group">
                        <span class="currency-label">ETB</span>
                        <input type="number" id="productPrice" name="price" class="form-input price-input" step="0.01" min="0" required>
                    </div>
                </div>
                
                <div class="form-group">
                    <label class="form-label">Product Image</label>
                    <div class="file-upload-area" id="fileUploadArea">
                        <div class="upload-icon">
                            <i class="fas fa-cloud-upload-alt"></i>
                        </div>
                        <div class="upload-text">
                            <p>Drag and drop an image here, or click to select</p>
                            <small>Supported formats: JPG, PNG, WebP (Max 5MB)</small>
                        </div>
                        <input type="file" id="productImage" name="image" accept="image/*" style="display: none;">
                    </div>
                    <img id="imagePreview" class="image-preview" style="display: none;">
                </div>
                
                <div class="form-actions">
                    <button type="button" class="btn-modal btn-cancel" onclick="closeProductModal()">Cancel</button>
                    <button type="submit" class="btn-modal btn-save">Save Product</button>
                </div>
            </form>
        </div>
    </div>
    
    <!-- Price Update Modal -->
    <div id="priceModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title">Update Price</h2>
                <button class="close-btn" onclick="closePriceModal()">&times;</button>
            </div>
            
            <form id="priceForm">
                <input type="hidden" id="priceProductId" name="productId">
                
                <div class="form-group">
                    <label class="form-label">Product Name</label>
                    <input type="text" id="priceProductName" class="form-input" readonly>
                </div>
                
                <div class="form-group">
                    <label class="form-label" for="currentPrice">Current Price</label>
                    <div class="price-input-group">
                        <span class="currency-label">ETB</span>
                        <input type="number" id="currentPrice" class="form-input price-input" readonly>
                    </div>
                </div>
                
                <div class="form-group">
                    <label class="form-label" for="newPrice">New Price *</label>
                    <div class="price-input-group">
                        <span class="currency-label">ETB</span>
                        <input type="number" id="newPrice" name="price" class="form-input price-input" step="0.01" min="0" required>
                    </div>
                </div>
                
                <div class="form-actions">
                    <button type="button" class="btn-modal btn-cancel" onclick="closePriceModal()">Cancel</button>
                    <button type="submit" class="btn-modal btn-save">Update Price</button>
                </div>
            </form>
        </div>
    </div>
    
    <!-- Toast container -->
    <div id="toastContainer"></div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Global variables
        let allMenuItems = [];
        let allProducts = [];
        let currentFilter = 'all';
        let currentCategory = 'all';
        let currentProductCategory = 'all';
        let currentOrderFilter = 'all';
        let soundEnabled = true;
        let knownOrderIds = new Set();
        let audioCtx = null;

        // ── LIVE CLOCK ──────────────────────────────────────────
        function updateClock() {
            const el = document.getElementById('liveClock');
            if (el) {
                const now = new Date();
                el.textContent = now.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
            }
        }
        setInterval(updateClock, 1000);
        updateClock();

        // ── SOUND ALERT ─────────────────────────────────────────
        function getAudioCtx() {
            if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            return audioCtx;
        }
        function playNewOrderSound() {
            if (!soundEnabled) return;
            try {
                const ctx = getAudioCtx();
                const tones = [880, 1047, 1319];
                tones.forEach((freq, i) => {
                    const osc = ctx.createOscillator();
                    const gain = ctx.createGain();
                    osc.type = 'sine';
                    osc.frequency.value = freq;
                    gain.gain.setValueAtTime(0, ctx.currentTime + i * 0.18);
                    gain.gain.linearRampToValueAtTime(0.35, ctx.currentTime + i * 0.18 + 0.05);
                    gain.gain.linearRampToValueAtTime(0, ctx.currentTime + i * 0.18 + 0.22);
                    osc.connect(gain);
                    gain.connect(ctx.destination);
                    osc.start(ctx.currentTime + i * 0.18);
                    osc.stop(ctx.currentTime + i * 0.18 + 0.25);
                });
            } catch(e) {}
        }
        function toggleSound() {
            soundEnabled = !soundEnabled;
            const btn = document.getElementById('soundToggleBtn');
            const lbl = document.getElementById('soundLabel');
            if (soundEnabled) {
                btn.classList.add('sound-on');
                lbl.textContent = 'Sound ON';
                btn.querySelector('i').className = 'fas fa-volume-up me-1';
            } else {
                btn.classList.remove('sound-on');
                lbl.textContent = 'Sound OFF';
                btn.querySelector('i').className = 'fas fa-volume-mute me-1';
            }
        }

        // ── TOAST NOTIFICATIONS ─────────────────────────────────
        function showToast(message, type = 'info', duration = 4000) {
            const icons = { success: '✅', error: '❌', warning: '⚠️', info: 'ℹ️', order: '🔔' };
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            toast.className = `kitchen-toast toast-${type}`;
            toast.innerHTML = `
                <span class="toast-icon">${icons[type] || icons.info}</span>
                <span class="toast-msg">${message}</span>
                <span class="toast-close" onclick="this.parentElement.remove()">✕</span>
            `;
            container.appendChild(toast);
            setTimeout(() => { if (toast.parentElement) { toast.style.opacity='0'; toast.style.transition='opacity 0.4s'; setTimeout(()=>toast.remove(),400); } }, duration);
        }

        // ── SCREEN FLASH on new order ───────────────────────────
        function flashScreen() {
            const flash = document.createElement('div');
            flash.className = 'new-order-flash';
            document.body.appendChild(flash);
            setTimeout(() => flash.remove(), 800);
        }

        // ── ORDER FILTER ────────────────────────────────────────
        function setOrderFilter(filter, el) {
            currentOrderFilter = filter;
            document.querySelectorAll('.order-filter-tab').forEach(t => t.classList.remove('active'));
            el.classList.add('active');
            loadOrders();
        }
        
        // Load dashboard data on page load
        document.addEventListener('DOMContentLoaded', function() {
            loadOrders();
            loadStatistics();
            loadMenuItems();
            loadCategories();
            loadProducts();
            loadProductCategories();
            setupFileUpload();
            
            // Fast polling: orders every 5s, stats every 15s, menu every 60s
            setInterval(loadOrders, 5000);
            setInterval(loadStatistics, 15000);
            setInterval(loadMenuItems, 60000);
            setInterval(loadProducts, 60000);
        });
        
        async function loadOrders() {
            try {
                const response = await fetch('/api/kitchen/orders');
                const data = await response.json();
                const orders = data.orders || data;
                
                // Detect new orders and alert
                const activeStatuses = ['pending','kitchen_confirmed','confirmed','preparing','ready'];
                const incoming = orders.filter(o => activeStatuses.includes(o.status));
                let hasNew = false;
                incoming.forEach(o => {
                    if (!knownOrderIds.has(o.id)) {
                        if (knownOrderIds.size > 0) { // don't alert on first load
                            hasNew = true;
                            showToast(`New order #${(o.order_number||o.id).toString().slice(-6).toUpperCase()} from ${o.customer_name}`, 'order', 6000);
                        }
                        knownOrderIds.add(o.id);
                    }
                });
                if (hasNew) { playNewOrderSound(); flashScreen(); }

                displayOrders(orders);

                const el = document.getElementById('lastRefreshed');
                if (el) el.textContent = 'Updated ' + new Date().toLocaleTimeString();
            } catch (error) {
                console.error('Error loading orders:', error);
            }
        }

        function displayOrders(allOrders) {
            const container = document.getElementById('ordersContainer');
            const activeStatuses = ['pending','kitchen_confirmed','confirmed','preparing','ready'];
            let orders = allOrders.filter(o => activeStatuses.includes(o.status));

            // Apply status filter
            if (currentOrderFilter !== 'all') {
                orders = orders.filter(o => o.status === currentOrderFilter);
            }

            if (orders.length === 0) {
                container.innerHTML = `
                    <div class="empty-state">
                        <div class="icon"><i class="fas fa-clipboard-check"></i></div>
                        <h3>No Active Orders</h3>
                        <p>${currentOrderFilter === 'all' ? 'All orders have been completed. Great job!' : 'No orders with this status.'}</p>
                    </div>
                `;
                return;
            }

            if (currentOrderFilter !== 'all') {
                // Flat grid for filtered view
                const grid = document.createElement('div');
                grid.className = 'orders-grid';
                orders.forEach(o => grid.appendChild(createOrderCard(o)));
                container.innerHTML = '';
                container.appendChild(grid);
                return;
            }

            // Kanban board
            const cols = [
                { key: 'pending',          label: '🕐 Pending',    icon: 'fa-clock',         cls: 'col-pending' },
                { key: 'kitchen_confirmed',label: '✅ Confirmed',   icon: 'fa-check-circle',  cls: 'col-confirmed' },
                { key: 'preparing',        label: '🔥 Preparing',  icon: 'fa-fire',          cls: 'col-preparing' },
                { key: 'ready',            label: '📦 Ready',      icon: 'fa-box-open',      cls: 'col-ready' },
            ];

            const board = document.createElement('div');
            board.className = 'kanban-board';

            cols.forEach(col => {
                const colOrders = orders.filter(o =>
                    col.key === 'kitchen_confirmed'
                        ? (o.status === 'kitchen_confirmed' || o.status === 'confirmed')
                        : o.status === col.key
                );
                const colEl = document.createElement('div');
                colEl.className = `kanban-col ${col.cls}`;
                colEl.innerHTML = `
                    <div class="kanban-col-header">
                        <i class="fas ${col.icon}"></i>
                        ${col.label}
                        <span class="kanban-count">${colOrders.length}</span>
                    </div>
                `;
                if (colOrders.length === 0) {
                    colEl.innerHTML += `<div class="kanban-empty">No orders here</div>`;
                } else {
                    colOrders.forEach(o => colEl.appendChild(createOrderCard(o)));
                }
                board.appendChild(colEl);
            });

            container.innerHTML = '';
            container.appendChild(board);
        }
        
        function createOrderCard(order) {
            const card = document.createElement('div');
            const minsAgo = order.created_at ? Math.floor((Date.now() - new Date(order.created_at).getTime()) / 60000) : null;
            const timeClass = minsAgo === null ? '' : minsAgo > 20 ? 'time-urgent' : minsAgo > 10 ? 'time-warn' : 'time-ok';
            const ageClass  = minsAgo > 20 ? 'urgent' : minsAgo > 10 ? 'warning-age' : '';
            card.className = `order-card ${ageClass}`;

            // Parse items
            let itemsHtml = '';
            try {
                const items = typeof order.items === 'string' ? JSON.parse(order.items) : (order.items || []);
                if (Array.isArray(items) && items.length) {
                    const rows = items.slice(0, 5).map(it =>
                        `<div class="item-row"><span>${it.name || it.item_name || 'Item'}</span><span class="item-qty">×${it.quantity||1}</span></div>`
                    ).join('');
                    const more = items.length > 5 ? `<div style="color:#475569;font-size:0.75rem">+${items.length-5} more</div>` : '';
                    itemsHtml = `<div class="order-items-list">${rows}${more}</div>`;
                }
            } catch(e) {}

            const payBadge = order.payment_method
                ? `<span class="badge-payment"><i class="fas fa-wallet me-1"></i>${order.payment_method}</span>` : '';
            const addr = order.customer_address
                ? `<div class="order-address"><i class="fas fa-map-marker-alt me-1"></i>${order.customer_address}</div>` : '';
            const timeDisplay = minsAgo !== null ? `${minsAgo}m ago` : '—';
            const statusLabel = { pending:'Pending', kitchen_confirmed:'Confirmed', confirmed:'Confirmed', preparing:'Preparing', ready:'Ready' }[order.status] || order.status;

            card.innerHTML = `
                <div class="order-header">
                    <div class="order-id">#${(order.order_number || order.id || '').toString().slice(-8).toUpperCase()}</div>
                    <div class="order-time ${timeClass}">${timeDisplay}</div>
                </div>
                <div class="order-customer">
                    <strong>${order.customer_name || '—'}</strong><br>
                    <small style="color:#64748b">${order.customer_phone || ''}</small>
                </div>
                ${addr}
                <div class="order-badges">${payBadge}<span class="badge-items-count"><i class="fas fa-tag me-1"></i>${statusLabel}</span></div>
                ${itemsHtml}
                <div class="order-total">Total: ${parseFloat(order.total_amount||0).toFixed(2)} ETB</div>
                <div class="order-actions">${getOrderActions(order)}</div>
            `;
            return card;
        }
        
        function getOrderActions(order) {
            switch (order.status) {
                case 'pending':
                    return `
                        <button class="action-btn btn-success" onclick="confirmAvailability('${order.id}', true)">
                            <i class="fas fa-check me-1"></i>
                            Available - Send Payment
                        </button>
                        <button class="action-btn btn-danger" onclick="showUnavailableModal('${order.id}')">
                            <i class="fas fa-times me-1"></i>
                            Unavailable
                        </button>
                    `;
                case 'confirmed':
                    return `
                        <button class="action-btn btn-warning" onclick="updateOrderStatus('${order.id}', 'preparing')">
                            <i class="fas fa-fire me-1"></i>
                            Start Cooking
                        </button>
                    `;
                case 'preparing':
                    return `
                        <button class="action-btn btn-success" onclick="updateOrderStatus('${order.id}', 'ready')">
                            <i class="fas fa-bell me-1"></i>
                            Mark Ready
                        </button>
                    `;
                case 'ready':
                    return `
                        <button class="action-btn btn-primary" onclick="viewOrderDetails('${order.id}')">
                            <i class="fas fa-eye me-1"></i>
                            View Details
                        </button>
                    `;
                default:
                    return '';
            }
        }
        
        async function updateOrderStatus(orderId, newStatus) {
            try {
                const response = await fetch(`/api/kitchen/orders/${orderId}`, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ status: newStatus })
                });

                if (response.ok) {
                    const result = await response.json();
                    if (result.success) {
                        const labels = { preparing: 'Cooking started 🔥', ready: 'Order marked Ready 📦' };
                        showToast(labels[newStatus] || 'Status updated', 'success');
                        loadOrders();
                        loadStatistics();
                    } else {
                        showToast('Failed: ' + (result.error || result.message), 'error');
                    }
                } else {
                    showToast(`Failed to update status (HTTP ${response.status})`, 'error');
                }
            } catch (error) {
                console.error('Error updating order status:', error);
                showToast('Network error: ' + error.message, 'error');
            }
        }
        
        function showUnavailableModal(orderId) {
