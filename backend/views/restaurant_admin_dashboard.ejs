    function saveMenuItem() {
        const form = document.getElementById('addMenuItemForm');
        const formData = new FormData(form);
        const saveBtn = document.querySelector('#addMenuItemModal .btn-primary');
        const originalText = saveBtn.innerHTML;
        saveBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Saving…';
        saveBtn.disabled = true;

        fetch('/api/menu', { method: 'POST', body: formData })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    bootstrap.Modal.getInstance(document.getElementById('addMenuItemModal')).hide();
                    loadMenuItems();
                    alert('Menu item added successfully!');
                } else {
                    alert('Error: ' + (data.error || 'Failed to add menu item'));
                }
            })
            .catch(err => { console.error(err); alert('Error saving menu item'); })
            .finally(() => { saveBtn.innerHTML = originalText; saveBtn.disabled = false; });
