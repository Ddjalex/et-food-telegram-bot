<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= admin.restaurant ? admin.restaurant.name : 'Restaurant' %> - Admin Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * { font-family: 'Inter', sans-serif; box-sizing: border-box; }

        body {
            background: #f4f6f9;
            color: #1e293b;
            margin: 0;
            padding: 0;
        }

        /* ── SIDEBAR ── */
        .admin-sidebar {
            width: 240px;
            min-height: 100vh;
            background: #ffffff;
            border-right: 1px solid #e8ecf0;
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0;
            left: 0;
            z-index: 100;
            box-shadow: 2px 0 8px rgba(0,0,0,0.04);
        }

        .sidebar-brand {
            padding: 24px 20px 20px;
            border-bottom: 1px solid #f0f2f5;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .sidebar-brand-icon {
            width: 38px;
            height: 38px;
            background: #4f46e5;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1rem;
            flex-shrink: 0;
        }

        .sidebar-brand-text {
            line-height: 1.2;
        }

        .sidebar-brand-name {
            font-weight: 700;
            font-size: 1rem;
            color: #1e293b;
        }

        .sidebar-brand-sub {
            font-size: 0.72rem;
            color: #94a3b8;
            font-weight: 400;
        }

        .sidebar-user {
            padding: 16px 20px;
            border-bottom: 1px solid #f0f2f5;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .user-avatar {
            width: 40px;
            height: 40px;
            background: linear-gradient(135deg, #4f46e5, #7c3aed);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 600;
            font-size: 1rem;
            flex-shrink: 0;
        }

        .user-info-name {
            font-weight: 600;
            font-size: 0.875rem;
            color: #1e293b;
        }

        .user-info-role {
            font-size: 0.75rem;
            color: #94a3b8;
        }

        .online-dot {
            display: inline-block;
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #22c55e;
            margin-right: 5px;
        }

        .sidebar-nav {
            padding: 16px 12px;
            flex: 1;
            overflow-y: auto;
        }

        .nav-section-label {
            font-size: 0.68rem;
            font-weight: 600;
            color: #94a3b8;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            padding: 0 8px;
            margin: 12px 0 6px;
        }

        .nav-pills .nav-link {
            display: flex;
            align-items: center;
            gap: 10px;
            color: #64748b;
            border-radius: 8px;
            padding: 9px 12px;
            font-size: 0.875rem;
            font-weight: 500;
            transition: all 0.15s ease;
            margin-bottom: 2px;
        }

        .nav-pills .nav-link i {
            width: 16px;
            text-align: center;
            font-size: 0.875rem;
            flex-shrink: 0;
        }

        .nav-pills .nav-link:hover {
            background: #f4f6f9;
            color: #1e293b;
        }

        .nav-pills .nav-link.active {
            background: #eef2ff;
            color: #4f46e5;
            font-weight: 600;
        }

        .sidebar-footer {
            padding: 16px 12px;
            border-top: 1px solid #f0f2f5;
        }

        .sidebar-footer a {
            display: flex;
            align-items: center;
            gap: 10px;
            color: #ef4444;
            font-size: 0.875rem;
            font-weight: 500;
            text-decoration: none;
            padding: 9px 12px;
            border-radius: 8px;
            transition: background 0.15s;
        }

        .sidebar-footer a:hover {
            background: #fef2f2;
        }

        /* ── MAIN CONTENT ── */
        .admin-main {
            margin-left: 240px;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* ── TOP BAR ── */
        .top-bar {
            background: #ffffff;
            border-bottom: 1px solid #e8ecf0;
            padding: 16px 28px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 90;
        }

        .top-bar-left h4 {
            font-size: 1.15rem;
            font-weight: 700;
            color: #1e293b;
            margin: 0;
        }

        .top-bar-left p {
            font-size: 0.78rem;
            color: #94a3b8;
            margin: 0;
        }

        .top-bar-actions {
            display: flex;
            gap: 8px;
            align-items: center;
        }

        .btn-topbar {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 8px 16px;
            font-size: 0.825rem;
            font-weight: 500;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.15s;
            border: 1px solid #e2e8f0;
            background: white;
            color: #475569;
        }

        .btn-topbar:hover {
            background: #f8fafc;
            border-color: #cbd5e1;
            color: #1e293b;
        }

        .btn-topbar-primary {
            background: #4f46e5;
            border-color: #4f46e5;
            color: white;
        }

        .btn-topbar-primary:hover {
            background: #4338ca;
            border-color: #4338ca;
            color: white;
        }

        .dropdown-menu {
            border: 1px solid #e8ecf0;
            box-shadow: 0 8px 24px rgba(0,0,0,0.1);
            border-radius: 10px;
            padding: 6px;
            min-width: 160px;
        }

        .dropdown-item {
            font-size: 0.85rem;
            padding: 8px 12px;
            border-radius: 6px;
            color: #475569;
            font-weight: 500;
        }

        .dropdown-item:hover {
            background: #f4f6f9;
            color: #1e293b;
        }

        .dropdown-divider { margin: 4px 0; }

        /* ── PAGE CONTENT ── */
        .page-content {
            padding: 24px 28px;
            flex: 1;
        }

        /* ── STAT CARDS ── */
        .stat-card {
            background: white;
            border-radius: 12px;
            padding: 20px;
            border: 1px solid #e8ecf0;
            display: flex;
            align-items: center;
            gap: 16px;
            transition: box-shadow 0.15s;
        }

        .stat-card:hover {
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
        }

        .stat-icon {
            width: 52px;
            height: 52px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
            flex-shrink: 0;
        }

        .stat-icon-blue   { background: #eff6ff; color: #3b82f6; }
        .stat-icon-green  { background: #f0fdf4; color: #22c55e; }
        .stat-icon-amber  { background: #fffbeb; color: #f59e0b; }
        .stat-icon-indigo { background: #eef2ff; color: #6366f1; }

        .stat-label {
            font-size: 0.78rem;
            color: #94a3b8;
            font-weight: 500;
            margin-bottom: 4px;
        }

        .stat-value {
            font-size: 1.5rem;
            font-weight: 700;
            color: #1e293b;
            line-height: 1;
        }

        .stat-trend {
            font-size: 0.72rem;
            font-weight: 500;
            margin-top: 6px;
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .stat-trend.up   { color: #22c55e; }
        .stat-trend.down { color: #ef4444; }

        /* ── SECTION CARDS ── */
        .section-card {
            background: white;
            border-radius: 12px;
            border: 1px solid #e8ecf0;
            overflow: hidden;
        }

        .section-card-header {
            padding: 16px 20px;
            border-bottom: 1px solid #f0f4f8;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .section-card-title {
            font-size: 0.95rem;
            font-weight: 600;
            color: #1e293b;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .section-card-title i {
            color: #4f46e5;
            font-size: 0.9rem;
        }

        /* ── TABLES ── */
        .table {
            margin-bottom: 0;
            font-size: 0.875rem;
        }

        .table thead th {
            background: #f8fafc;
            color: #64748b;
            font-weight: 600;
            font-size: 0.78rem;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            padding: 12px 16px;
            border-bottom: 1px solid #e8ecf0;
            border-top: none;
        }

        .table tbody td {
            padding: 12px 16px;
            vertical-align: middle;
            border-color: #f0f4f8;
            color: #334155;
        }

        .table-hover tbody tr:hover {
            background: #f8fafc;
        }

        /* ── STATUS BADGES ── */
        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        .status-badge::before {
            content: '';
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: currentColor;
        }

        .status-pending      { background: #fffbeb; color: #d97706; }
        .status-confirmed    { background: #eff6ff; color: #3b82f6; }
        .status-preparing    { background: #faf5ff; color: #9333ea; }
        .status-ready        { background: #f0fdf4; color: #16a34a; }
        .status-out_for_delivery { background: #fff7ed; color: #ea580c; }
        .status-delivered    { background: #f0fdf4; color: #22c55e; }
        .status-cancelled    { background: #fef2f2; color: #ef4444; }
        .status-active       { background: #f0fdf4; color: #22c55e; }
        .status-inactive     { background: #f1f5f9; color: #94a3b8; }
        .status-approved     { background: #f0fdf4; color: #16a34a; }

        /* ── QUICK ACTIONS ── */
        .quick-actions-row {
            display: flex;
            gap: 12px;
            margin-bottom: 24px;
            flex-wrap: wrap;
        }

        .quick-action {
            flex: 1;
            min-width: 120px;
            background: white;
            border: 1px solid #e8ecf0;
            border-radius: 12px;
            padding: 16px 12px;
            text-align: center;
            text-decoration: none;
            color: #64748b;
            font-size: 0.825rem;
            font-weight: 500;
            transition: all 0.15s;
        }

        .quick-action:hover {
            border-color: #4f46e5;
            color: #4f46e5;
            background: #eef2ff;
            transform: translateY(-1px);
        }

        .quick-action i {
            display: block;
            font-size: 1.5rem;
            margin-bottom: 6px;
        }

        /* ── CHART CONTAINERS ── */
        .chart-wrap {
            position: relative;
            height: 280px;
            padding: 16px;
        }

        /* ── ANALYTICS GRID ── */
        .analytics-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 24px;
        }

        /* ── BUTTONS ── */
        .btn-sm-action {
            padding: 5px 10px;
            font-size: 0.78rem;
            border-radius: 6px;
            font-weight: 500;
        }

        .btn-primary {
            background: #4f46e5;
            border-color: #4f46e5;
            font-weight: 500;
            border-radius: 8px;
        }

        .btn-primary:hover {
            background: #4338ca;
            border-color: #4338ca;
        }

        .btn-outline-primary { border-color: #4f46e5; color: #4f46e5; border-radius: 6px; }
        .btn-outline-primary:hover { background: #4f46e5; color: white; }
        .btn-outline-success { border-radius: 6px; }
        .btn-outline-warning { border-radius: 6px; }
        .btn-outline-danger  { border-radius: 6px; }

        /* ── FORM ELEMENTS ── */
        .form-control, .form-select {
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            font-size: 0.875rem;
            color: #1e293b;
        }

        .form-control:focus, .form-select:focus {
            border-color: #4f46e5;
            box-shadow: 0 0 0 3px rgba(79,70,229,0.1);
        }

        .form-label {
            font-size: 0.825rem;
            font-weight: 600;
            color: #475569;
        }

        /* ── TAB PANE ── */
        .tab-pane { display: none; }
        .tab-pane.active { display: block; }

        /* ── MODAL ── */
        .modal-header { border-bottom: 1px solid #f0f4f8; }
        .modal-footer { border-top: 1px solid #f0f4f8; }
        .modal-content { border-radius: 14px; border: none; box-shadow: 0 20px 60px rgba(0,0,0,0.15); }

        /* ── PERFORMANCE INDICATOR ── */
        .performance-indicator {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            font-size: 0.75rem;
            font-weight: 500;
        }

        .performance-indicator.positive { color: #22c55e; }
        .performance-indicator.negative { color: #ef4444; }

        /* ── KITCHEN LOGO CONTAINER ── */
        .kitchen-logo-container {
            position: relative;
            display: inline-block;
        }

        /* ── SECTION SPACING ── */
        .section-mb { margin-bottom: 24px; }

        @media (max-width: 768px) {
            .admin-sidebar { width: 200px; }
            .admin-main { margin-left: 200px; }
            .analytics-grid { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>

<!-- SIDEBAR -->
<div class="admin-sidebar">
    <div class="sidebar-brand">
        <div class="sidebar-brand-icon">
            <i class="fas fa-utensils"></i>
        </div>
        <div class="sidebar-brand-text">
            <div class="sidebar-brand-name">ET-FOOD</div>
            <div class="sidebar-brand-sub">Admin Dashboard</div>
        </div>
    </div>

    <div class="sidebar-user">
        <div class="user-avatar">
            <%= admin.full_name ? admin.full_name[0].toUpperCase() : 'A' %>
        </div>
        <div>
            <div class="user-info-name"><%= admin.full_name %></div>
            <div class="user-info-role">
                <span class="online-dot"></span>
                <%= admin.restaurant ? admin.restaurant.name : 'No Restaurant' %>
            </div>
        </div>
    </div>

    <nav class="nav nav-pills flex-column sidebar-nav">
        <div class="nav-section-label">Navigation</div>
        <a class="nav-link active" data-bs-toggle="pill" href="#dashboard">
            <i class="fas fa-th-large"></i>
            Dashboard
        </a>
        <a class="nav-link" data-bs-toggle="pill" href="#orders">
            <i class="fas fa-shopping-bag"></i>
            Orders
        </a>
        <a class="nav-link" data-bs-toggle="pill" href="#menu">
            <i class="fas fa-utensils"></i>
            Menu Management
        </a>
        <a class="nav-link" data-bs-toggle="pill" href="#categories">
            <i class="fas fa-tags"></i>
            Categories
        </a>
        <% if (admin.role === 'super_admin' || (admin.role === 'admin' && admin.is_approved)) { %>
        <a class="nav-link" data-bs-toggle="pill" href="#drivers">
            <i class="fas fa-motorcycle"></i>
            Drivers
        </a>
        <% } %>
        <div class="nav-section-label">Insights</div>
        <a class="nav-link" data-bs-toggle="pill" href="#analytics">
            <i class="fas fa-chart-line"></i>
            Analytics
        </a>
        <div class="nav-section-label">Management</div>
        <a class="nav-link" data-bs-toggle="pill" href="#kitchen-staff">
            <i class="fas fa-users"></i>
            Kitchen Staff
        </a>
        <a class="nav-link" data-bs-toggle="pill" href="#settings">
            <i class="fas fa-cog"></i>
            Settings
        </a>
    </nav>

    <div class="sidebar-footer">
        <a href="/admin/logout">
            <i class="fas fa-sign-out-alt"></i>
            Logout
        </a>
    </div>
</div>

<!-- MAIN CONTENT -->
<div class="admin-main">

    <!-- TOP BAR -->
    <div class="top-bar">
        <div class="top-bar-left">
            <h4><%= admin.restaurant ? admin.restaurant.name : 'Restaurant' %> Dashboard</h4>
            <p id="currentDateTime"></p>
        </div>
        <div class="top-bar-actions">
            <button class="btn-topbar" id="exportOrdersBtn">
                <i class="fas fa-download"></i> Export
            </button>
            <button class="btn-topbar" id="refreshBtn">
                <i class="fas fa-sync"></i> Refresh
            </button>
            <div class="dropdown">
                <button class="btn-topbar dropdown-toggle" type="button" data-bs-toggle="dropdown">
                    <i class="fas fa-user-circle"></i> <%= admin.full_name %>
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><a class="dropdown-item" href="#"><i class="fas fa-user me-2"></i>Profile</a></li>
                    <li><a class="dropdown-item" href="#" onclick="switchToTab('settings')"><i class="fas fa-cog me-2"></i>Settings</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item text-danger" href="/admin/logout"><i class="fas fa-sign-out-alt me-2"></i>Logout</a></li>
                </ul>
            </div>
        </div>
    </div>

    <!-- PAGE CONTENT -->
    <div class="page-content">
        <div class="tab-content" id="adminTabsContent">

            <!-- ═══════════════════════ DASHBOARD TAB ═══════════════════════ -->
            <div class="tab-pane fade show active" id="dashboard" role="tabpanel">

                <!-- Quick Actions -->
                <div class="quick-actions-row">
                    <a href="#" class="quick-action" onclick="switchToTab('orders'); return false;">
                        <i class="fas fa-plus-circle"></i>New Order
                    </a>
                    <a href="#" class="quick-action" onclick="switchToTab('menu'); return false;">
                        <i class="fas fa-utensils"></i>Menu
                    </a>
                    <a href="#" class="quick-action" onclick="switchToTab('analytics'); return false;">
                        <i class="fas fa-chart-line"></i>Analytics
                    </a>
                    <% if (admin.role === 'super_admin' || (admin.role === 'admin' && admin.is_approved)) { %>
                    <a href="#" class="quick-action" onclick="switchToTab('drivers'); return false;">
                        <i class="fas fa-motorcycle"></i>Drivers
                    </a>
                    <% } %>
                </div>

                <!-- Stat Cards -->
                <div class="row g-3 section-mb">
                    <div class="col-md-3 col-sm-6">
                        <div class="stat-card">
                            <div class="stat-icon stat-icon-blue">
                                <i class="fas fa-shopping-bag"></i>
                            </div>
                            <div>
                                <div class="stat-label">Today's Orders</div>
                                <div class="stat-value" id="totalOrders">0</div>
                                <div class="stat-trend up"><i class="fas fa-arrow-up"></i> +12%</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 col-sm-6">
                        <div class="stat-card">
                            <div class="stat-icon stat-icon-green">
                                <i class="fas fa-dollar-sign"></i>
                            </div>
                            <div>
                                <div class="stat-label">Today's Revenue</div>
                                <div class="stat-value" id="totalRevenue" style="font-size:1.2rem;">ETB 0</div>
                                <div class="stat-trend up"><i class="fas fa-arrow-up"></i> +8%</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 col-sm-6">
                        <div class="stat-card">
                            <div class="stat-icon stat-icon-amber">
                                <i class="fas fa-clock"></i>
                            </div>
                            <div>
                                <div class="stat-label">Pending Orders</div>
                                <div class="stat-value" id="pendingOrders">0</div>
                                <div class="stat-trend down"><i class="fas fa-arrow-down"></i> -5%</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 col-sm-6">
                        <div class="stat-card">
                            <div class="stat-icon stat-icon-indigo">
                                <i class="fas fa-motorcycle"></i>
                            </div>
                            <div>
                                <div class="stat-label">Menu Items</div>
                                <div class="stat-value" id="activeDrivers">0</div>
                                <div class="stat-trend up"><i class="fas fa-arrow-up"></i> +2 New</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Charts Row -->
                <div class="analytics-grid section-mb">
                    <div class="section-card">
                        <div class="section-card-header">
                            <h6 class="section-card-title"><i class="fas fa-chart-line"></i>Sales Overview</h6>
                        </div>
                        <div class="chart-wrap">
                            <canvas id="salesChart"></canvas>
                        </div>
                    </div>
                    <div class="section-card">
                        <div class="section-card-header">
                            <h6 class="section-card-title"><i class="fas fa-chart-pie"></i>Order Status</h6>
                        </div>
                        <div class="chart-wrap">
                            <canvas id="statusChart"></canvas>
                        </div>
                    </div>
                </div>

                <!-- Recent Orders -->
                <div class="section-card section-mb">
                    <div class="section-card-header">
                        <h6 class="section-card-title"><i class="fas fa-history"></i>Recent Orders</h6>
                        <button class="btn btn-primary btn-sm" onclick="switchToTab('orders')">
                            View All
                        </button>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Order ID</th>
                                    <th>Customer</th>
                                    <th>Items</th>
                                    <th>Status</th>
                                    <th>Total</th>
                                    <th>Time</th>
                                </tr>
                            </thead>
                            <tbody id="recentOrdersTable">
                                <tr>
                                    <td colspan="6" class="text-center py-4">
                                        <div class="spinner-border text-primary spinner-border-sm" role="status"></div>
                                        <span class="ms-2 text-muted">Loading orders…</span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- ═══════════════════════ ORDERS TAB ═══════════════════════ -->
            <div class="tab-pane fade" id="orders" role="tabpanel">
                <div class="section-card section-mb">
                    <div class="section-card-header">
                        <h6 class="section-card-title"><i class="fas fa-shopping-bag"></i>Orders Management</h6>
                        <div class="d-flex gap-2 align-items-center">
                            <select class="form-select form-select-sm" id="statusFilter" onchange="loadOrders(1, this.value)" style="min-width:150px;">
                                <option value="all">All Status</option>
                                <option value="pending">Pending</option>
                                <option value="confirmed">Confirmed</option>
                                <option value="preparing">Preparing</option>
                                <option value="ready">Ready</option>
