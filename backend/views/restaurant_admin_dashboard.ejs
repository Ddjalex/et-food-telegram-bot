    function loadKitchenStaff() {
        console.log('Loading kitchen staff...');
        fetch('/api/admin/kitchen-staff')
            .then(r => { if (!r.ok) throw new Error(`HTTP ${r.status}`); return r.json(); })
            .then(data => {
                const staff = data.kitchen_staff || [];
                const tbody = document.getElementById('kitchenStaffTable');
                if (staff.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="7" class="text-center py-4 text-muted">No kitchen staff found</td></tr>';
                    return;
                }
                const defaultAvatar = `data:image/svg+xml;base64,`;
                tbody.innerHTML = staff.map(m => `
                    <tr>
                        <td>
                            <img src="${m.photo_url || defaultAvatar}"
                                 class="rounded-circle" style="width:38px;height:38px;object-fit:cover;border:2px solid #e8ecf0;"
                                 alt="${m.full_name}" onerror="this.src='${defaultAvatar}'">
                        </td>
                        <td><strong>${m.full_name}</strong></td>
                        <td class="text-muted">${m.username}</td>
                        <td>${m.phone || '—'}</td>
                        <td><span class="status-badge ${m.is_active ? 'status-active' : 'status-inactive'}">${m.is_active ? 'Active' : 'Inactive'}</span></td>
                        <td class="text-muted">${formatTime(m.created_at)}</td>
                        <td>
                            <div class="d-flex gap-1">
                                <button class="btn btn-sm btn-outline-primary btn-sm-action" onclick="editKitchenStaff(${m.id})" title="Edit">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-warning btn-sm-action" onclick="changeStaffPassword(${m.id},'${m.full_name || m.username}')" title="Change Password">
                                    <i class="fas fa-key"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger btn-sm-action" onclick="deleteKitchenStaff(${m.id})" title="Delete">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                `).join('');
            })
            .catch(err => {
                console.error('Error loading kitchen staff:', err);
                document.getElementById('kitchenStaffTable').innerHTML = '<tr><td colspan="7" class="text-center py-4 text-danger">Error loading kitchen staff</td></tr>';
            });
    }

