        input.onchange = function(e) {
            const file = e.target.files[0];
            if (!file) return;
            const formData = new FormData();
            formData.append('logo', file);
            fetch('/api/admin/kitchen-logo', { method: 'POST', body: formData })
                .then(r => r.json())
                .then(data => {
                    if (data.success) {
                        document.getElementById('kitchenLogo').src = data.logo_url + '?t=' + Date.now();
                        alert('Kitchen logo updated!');
                    } else {
                        alert('Error: ' + (data.error || 'Failed to upload logo'));
                    }
                })
                .catch(err => { console.error(err); alert('Error uploading logo'); });
        };
        input.click();
    }

