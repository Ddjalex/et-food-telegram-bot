                                <option value="delivered">Delivered</option>
                                <option value="cancelled">Cancelled</option>
                            </select>
                            <button class="btn btn-primary btn-sm" onclick="loadOrders(1, 'all')">
                                <i class="fas fa-sync me-1"></i>Refresh
                            </button>
                        </div>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Order ID</th>
                                    <th>Customer</th>
                                    <th>Items</th>
                                    <th>Status</th>
                                    <th>Payment</th>
                                    <th>Total</th>
                                    <th>Time</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody id="ordersTable">
                                <tr>
                                    <td colspan="8" class="text-center py-4">
                                        <div class="spinner-border text-primary spinner-border-sm" role="status"></div>
                                        <span class="ms-2 text-muted">Loading orders…</span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- ═══════════════════════ MENU MANAGEMENT TAB ═══════════════════════ -->
            <div class="tab-pane fade" id="menu" role="tabpanel">
                <div class="section-card section-mb">
                    <div class="section-card-header">
                        <h6 class="section-card-title"><i class="fas fa-utensils"></i>Menu Management</h6>
                        <button class="btn btn-primary btn-sm" onclick="showAddMenuItemModal()">
                            <i class="fas fa-plus me-1"></i>Add New Item
                        </button>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Image</th>
                                    <th>Name</th>
                                    <th>Category</th>
                                    <th>Price</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody id="menuItemsTable">
                                <tr>
                                    <td colspan="6" class="text-center py-4">
                                        <div class="spinner-border text-primary spinner-border-sm" role="status"></div>
                                        <span class="ms-2 text-muted">Loading menu…</span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- ═══════════════════════ CATEGORIES TAB ═══════════════════════ -->
            <div class="tab-pane fade" id="categories" role="tabpanel">
                <div class="section-card section-mb">
                    <div class="section-card-header">
                        <h6 class="section-card-title"><i class="fas fa-tags"></i>Categories Management</h6>
                        <button class="btn btn-primary btn-sm" id="addCategoryBtn">
                            <i class="fas fa-plus me-1"></i>Add Category
                        </button>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Icon</th>
                                    <th>Name</th>
                                    <th>Description</th>
                                    <th>Items Count</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody id="categoriesTable">
                                <tr>
                                    <td colspan="5" class="text-center py-4">
                                        <div class="spinner-border text-primary spinner-border-sm" role="status"></div>
                                        <span class="ms-2 text-muted">Loading categories…</span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- ═══════════════════════ DRIVERS TAB ═══════════════════════ -->
            <% if (admin.role === 'super_admin' || (admin.role === 'admin' && admin.is_approved)) { %>
            <div class="tab-pane fade" id="drivers" role="tabpanel">
                <div class="section-card section-mb">
                    <div class="section-card-header">
                        <h6 class="section-card-title"><i class="fas fa-motorcycle"></i>Drivers Management</h6>
                        <button class="btn btn-primary btn-sm" id="addDriverBtn">
                            <i class="fas fa-plus me-1"></i>Add Driver
                        </button>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Phone</th>
                                    <th>Vehicle</th>
                                    <th>Status</th>
                                    <th>Active</th>
                                    <th>Location Status</th>
                                    <th>Documents</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody id="driversTable">
                                <tr>
                                    <td colspan="8" class="text-center py-4">
                                        <div class="spinner-border text-primary spinner-border-sm" role="status"></div>
                                        <span class="ms-2 text-muted">Loading drivers…</span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <% } %>

            <!-- ═══════════════════════ ANALYTICS TAB ═══════════════════════ -->
            <div class="tab-pane fade" id="analytics" role="tabpanel">
                <div class="analytics-grid section-mb">
                    <div class="section-card">
                        <div class="section-card-header">
                            <h6 class="section-card-title"><i class="fas fa-chart-bar"></i>Daily Sales</h6>
                        </div>
                        <div class="chart-wrap">
                            <canvas id="dailySalesChart"></canvas>
                        </div>
                    </div>
                    <div class="section-card">
                        <div class="section-card-header">
                            <h6 class="section-card-title"><i class="fas fa-fire"></i>Popular Items</h6>
                        </div>
                        <div class="chart-wrap">
                            <canvas id="popularItemsChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ═══════════════════════ KITCHEN STAFF TAB ═══════════════════════ -->
            <div class="tab-pane fade" id="kitchen-staff" role="tabpanel">
                <div class="section-card section-mb">
                    <div class="section-card-header">
                        <div class="d-flex align-items-center gap-3">
                            <div class="kitchen-logo-container">
                                <img id="kitchenLogo" src="/static/uploads/kitchen_logo.svg" alt="Kitchen"
                                     class="rounded-circle" style="width: 38px; height: 38px; object-fit: cover; border: 2px solid #e8ecf0;"
                                     onerror="this.src='data:image/svg+xml;base64,'">
                                <button class="btn btn-sm btn-outline-secondary position-absolute"
                                        style="top:-4px;right:-4px;width:18px;height:18px;border-radius:50%;padding:0;font-size:9px;line-height:1;"
                                        onclick="uploadKitchenLogo()" title="Change Logo">
                                    <i class="fas fa-camera"></i>
                                </button>
                            </div>
                            <h6 class="section-card-title mb-0"><i class="fas fa-users"></i>Kitchen Staff Management</h6>
                        </div>
                        <button class="btn btn-primary btn-sm" onclick="showAddKitchenStaffModal()">
                            <i class="fas fa-plus me-1"></i>Add Kitchen Staff
                        </button>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Photo</th>
                                    <th>Name</th>
                                    <th>Username</th>
                                    <th>Phone</th>
                                    <th>Status</th>
                                    <th>Created</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody id="kitchenStaffTable">
                                <tr>
                                    <td colspan="7" class="text-center py-4">
                                        <div class="spinner-border text-primary spinner-border-sm" role="status"></div>
                                        <span class="ms-2 text-muted">Loading kitchen staff…</span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- ═══════════════════════ SETTINGS TAB ═══════════════════════ -->
            <div class="tab-pane fade" id="settings" role="tabpanel">
                <div class="section-card section-mb">
                    <div class="section-card-header">
                        <h6 class="section-card-title"><i class="fas fa-cog"></i>Restaurant Settings</h6>
                    </div>
                    <div class="p-4">
                        <form id="settingsForm">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label">Delivery Radius (km)</label>
                                        <input type="number" class="form-control" id="deliveryRadius" value="10">
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label">Minimum Order Amount (ETB)</label>
                                        <input type="number" class="form-control" id="minOrderAmount" value="50">
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label">Delivery Fee (ETB)</label>
                                        <input type="number" class="form-control" id="deliveryFee" value="15">
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label">Service Hours</label>
                                        <input type="text" class="form-control" id="serviceHours" value="8:00 AM - 11:00 PM">
                                    </div>
                                </div>
                            </div>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save me-2"></i>Save Settings
                            </button>
                        </form>
                    </div>
                </div>
            </div>

        </div><!-- end tab-content -->
    </div><!-- end page-content -->
</div><!-- end admin-main -->

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    // ── State ──
    let ordersData = [];
    let currentPage = 1;
    let currentStatus = 'all';

    // ── Date/time ticker ──
    function updateDateTime() {
        const el = document.getElementById('currentDateTime');
        if (el) el.textContent = new Date().toLocaleString();
    }
    setInterval(updateDateTime, 1000);
    updateDateTime();

    // ── Boot ──
    document.addEventListener('DOMContentLoaded', function() {
        initializeDashboard();
        setupEventListeners();
        setupTabSwitching();
        loadMenuItems();
        loadCategories();
        loadDrivers();
        loadKitchenStaff();
    });

    function initializeDashboard() {
        loadDashboardStats();
        loadRecentOrders();
        initializeCharts();
    }

    function initializeCharts() {
        if (typeof Chart === 'undefined') { console.error('Chart.js not loaded'); return; }

        // Sales chart
        const salesCtx = document.getElementById('salesChart').getContext('2d');
        new Chart(salesCtx, {
            type: 'line',
            data: {
                labels: ['Mon','Tue','Wed','Thu','Fri','Sat','Sun'],
                datasets: [{
                    label: 'Sales (ETB)',
                    data: [1200,1900,1500,2100,1800,2500,2200],
                    borderColor: '#4f46e5',
                    backgroundColor: 'rgba(79,70,229,0.08)',
                    fill: true,
                    tension: 0.4,
                    pointBackgroundColor: '#4f46e5',
                    pointRadius: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    y: { beginAtZero: true, grid: { color: 'rgba(0,0,0,0.05)' }, ticks: { color: '#94a3b8', font: { size: 11 } } },
                    x: { grid: { display: false }, ticks: { color: '#94a3b8', font: { size: 11 } } }
                }
            }
        });

        // Status doughnut
        const statusCtx = document.getElementById('statusChart').getContext('2d');
        new Chart(statusCtx, {
            type: 'doughnut',
            data: {
                labels: ['Pending','Preparing','Ready','Delivered'],
                datasets: [{
                    data: [12,8,5,25],
                    backgroundColor: ['#f59e0b','#4f46e5','#22c55e','#3b82f6'],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '65%',
                plugins: {
                    legend: { position: 'bottom', labels: { usePointStyle: true, padding: 16, font: { size: 12 } } }
                }
            }
        });
    }

    function setupEventListeners() {
        document.getElementById('refreshBtn').addEventListener('click', initializeDashboard);
        document.getElementById('exportOrdersBtn').addEventListener('click', exportOrders);
        document.getElementById('settingsForm').addEventListener('submit', function(e) {
            e.preventDefault();
            saveSettings();
        });
    }

    function setupTabSwitching() {
        document.querySelectorAll('[data-bs-toggle="pill"]').forEach(link => {
            link.addEventListener('shown.bs.tab', function(e) {
                const target = e.target.getAttribute('href');
                if (target === '#menu')       setTimeout(() => loadMenuItems(), 100);
                else if (target === '#categories') setTimeout(() => loadCategories(), 100);
                else if (target === '#drivers')    setTimeout(() => loadDrivers(), 100);
                else if (target === '#orders')     { setTimeout(() => loadOrders(1,'all'), 100); setTimeout(() => loadKitchenStaff(), 100); }
                else if (target === '#dashboard')  { setTimeout(() => { loadDashboardStats(); loadRecentOrders(); }, 100); }
            });
        });
    }

    function switchToTab(tabId) {
        const link = document.querySelector(`[href="#${tabId}"]`);
        if (link) bootstrap.Tab.getOrCreateInstance(link).show();
    }

    // ── API Calls ──
    function loadDashboardStats() {
        console.log('Loading dashboard stats...');
        fetch('/api/admin/dashboard-stats')
            .then(r => { if (!r.ok) throw new Error(`HTTP ${r.status}`); return r.json(); })
            .then(data => {
                document.getElementById('totalOrders').textContent   = data.todayOrders   || 0;
                document.getElementById('totalRevenue').textContent  = `ETB ${data.todayRevenue || 0}`;
                document.getElementById('pendingOrders').textContent = data.pendingOrders || 0;
                document.getElementById('activeDrivers').textContent = data.menuItems     || 0;
            })
            .catch(err => {
                console.error('Error loading stats:', err);
                ['totalOrders','totalRevenue','pendingOrders','activeDrivers'].forEach(id => {
                    document.getElementById(id).textContent = 'Error';
                });
            });
    }

    function loadRecentOrders() {
        console.log('Loading recent orders...');
        fetch('/api/admin/recent-orders')
            .then(r => { if (!r.ok) throw new Error(`HTTP ${r.status}`); return r.json(); })
            .then(data => {
                const orders = Array.isArray(data) ? data : (data.orders || []);
                const tbody = document.getElementById('recentOrdersTable');
                if (orders.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="6" class="text-center py-4 text-muted">No recent orders found</td></tr>';
                    return;
                }
                tbody.innerHTML = orders.slice(0,10).map(order => `
                    <tr>
                        <td><strong>#${(order.order_number || order.id).slice(-6).toUpperCase()}</strong></td>
                        <td>${order.customer_name}</td>
                        <td>${order.items ? order.items.length : 0} items</td>
                        <td><span class="status-badge status-${order.status}">${order.status}</span></td>
                        <td><strong>ETB ${order.total_amount}</strong></td>
                        <td class="text-muted">${formatTime(order.created_at)}</td>
                    </tr>
                `).join('');
            })
            .catch(err => {
                console.error('Error loading recent orders:', err);
                document.getElementById('recentOrdersTable').innerHTML = '<tr><td colspan="6" class="text-center py-4 text-danger">Error loading orders</td></tr>';
            });
    }

    function loadOrders(page = 1, status = 'all') {
        console.log('Loading orders, status:', status);
        const params = new URLSearchParams({ page, status });
        fetch(`/api/admin/orders?${params}`)
            .then(r => { if (!r.ok) throw new Error(`HTTP ${r.status}`); return r.json(); })
            .then(data => {
                const orders = Array.isArray(data) ? data : (data.orders || []);
                const tbody = document.getElementById('ordersTable');
                if (orders.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="8" class="text-center py-4 text-muted">No orders found</td></tr>';
                    return;
                }
                tbody.innerHTML = orders.map(order => `
                    <tr>
                        <td><strong>#${(order.order_number || order.id).slice(-6).toUpperCase()}</strong></td>
                        <td>${order.customer_name}</td>
                        <td>${order.items ? order.items.length : 0} items</td>
                        <td><span class="status-badge status-${order.status}">${order.status}</span></td>
                        <td><span class="badge bg-light text-dark border">${order.payment_method || 'N/A'}</span></td>
                        <td><strong>ETB ${order.total_amount}</strong></td>
                        <td class="text-muted">${formatTime(order.created_at)}</td>
                        <td>
                            <div class="d-flex gap-1">
                                <button class="btn btn-sm btn-outline-primary btn-sm-action" onclick="viewOrder(${order.id})" title="View">
                                    <i class="fas fa-eye"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-success btn-sm-action" onclick="updateOrderStatus(${order.id},'confirmed')" title="Confirm">
                                    <i class="fas fa-check"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                `).join('');
            })
            .catch(err => {
                console.error('Error loading orders:', err);
                document.getElementById('ordersTable').innerHTML = '<tr><td colspan="8" class="text-center py-4 text-danger">Error loading orders</td></tr>';
            });
    }

    function loadMenuItems() {
        console.log('Loading menu items...');
        fetch('/api/menu')
            .then(r => { if (!r.ok) throw new Error(`HTTP ${r.status}`); return r.json(); })
            .then(data => {
                const items = Array.isArray(data) ? data : (data.items || data.menuItems || []);
                const tbody = document.getElementById('menuItemsTable');
                if (items.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="6" class="text-center py-4 text-muted">No menu items found. Add your first item!</td></tr>';
                    return;
                }
                tbody.innerHTML = items.map(item => `
                    <tr>
                        <td>
                            <img src="${item.image_url || '/static/images/default-food.png'}"
                                 class="rounded" style="width:44px;height:44px;object-fit:cover;border:1px solid #e8ecf0;"
                                 alt="${item.name}" onerror="this.src='/static/images/default-food.png'">
                        </td>
                        <td><strong>${item.name}</strong></td>
                        <td><span class="badge bg-light text-dark border">${item.category || 'N/A'}</span></td>
                        <td><strong>ETB ${item.price}</strong></td>
                        <td><span class="status-badge ${item.available ? 'status-delivered' : 'status-cancelled'}">${item.available ? 'Available' : 'Unavailable'}</span></td>
                        <td>
                            <div class="d-flex gap-1">
                                <button class="btn btn-sm btn-outline-primary btn-sm-action" onclick="editMenuItem(${item.id})" title="Edit">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger btn-sm-action" onclick="deleteMenuItem(${item.id})" title="Delete">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                `).join('');
            })
            .catch(err => {
                console.error('Error loading menu items:', err);
                document.getElementById('menuItemsTable').innerHTML = '<tr><td colspan="6" class="text-center py-4 text-danger">Error loading menu items</td></tr>';
            });
    }

    function loadCategories() {
        console.log('Loading categories...');
        fetch('/api/categories')
            .then(r => { if (!r.ok) throw new Error(`HTTP ${r.status}`); return r.json(); })
            .then(data => {
                const cats = Array.isArray(data) ? data : (data.categories || []);
                const tbody = document.getElementById('categoriesTable');
                if (cats.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="5" class="text-center py-4 text-muted">No categories found</td></tr>';
                    return;
                }
                tbody.innerHTML = cats.map(cat => `
                    <tr>
                        <td><span style="font-size:1.4rem;">${cat.icon || '🍽️'}</span></td>
                        <td><strong>${cat.name}</strong></td>
                        <td class="text-muted">${cat.description || '—'}</td>
                        <td><span class="badge bg-light text-dark border">${cat.item_count || 0} items</span></td>
                        <td>
                            <div class="d-flex gap-1">
                                <button class="btn btn-sm btn-outline-primary btn-sm-action" onclick="editCategory(${cat.id})" title="Edit">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger btn-sm-action" onclick="deleteCategory(${cat.id})" title="Delete">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                `).join('');
            })
            .catch(err => {
                console.error('Error loading categories:', err);
                document.getElementById('categoriesTable').innerHTML = '<tr><td colspan="5" class="text-center py-4 text-danger">Error loading categories</td></tr>';
            });
    }

    function loadDrivers() {
        const tbody = document.getElementById('driversTable');
        if (!tbody) return;
        console.log('Loading drivers...');
        fetch('/api/admin/drivers')
            .then(r => { if (!r.ok) throw new Error(`HTTP ${r.status}`); return r.json(); })
            .then(data => {
                const drivers = Array.isArray(data) ? data : (data.drivers || []);
                if (drivers.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="8" class="text-center py-4 text-muted">No drivers found</td></tr>';
                    return;
                }
                tbody.innerHTML = drivers.map(d => `
                    <tr>
                        <td><strong>${d.full_name || d.name}</strong></td>
                        <td>${d.phone || '—'}</td>
                        <td>${d.vehicle_type || '—'}</td>
                        <td><span class="status-badge ${d.status === 'available' ? 'status-delivered' : 'status-pending'}">${d.status || 'unknown'}</span></td>
                        <td><span class="status-badge ${d.is_active ? 'status-active' : 'status-inactive'}">${d.is_active ? 'Active' : 'Inactive'}</span></td>
                        <td>${d.last_location ? '<span class="status-badge status-confirmed">Sharing</span>' : '<span class="status-badge status-inactive">None</span>'}</td>
                        <td>
                            <button class="btn btn-sm btn-outline-primary btn-sm-action" onclick="viewDriverDocuments(${d.id})" title="Documents">
                                <i class="fas fa-file-alt"></i>
                            </button>
                        </td>
                        <td>
                            <div class="d-flex gap-1">
                                <button class="btn btn-sm btn-outline-success btn-sm-action" onclick="approveDriver(${d.id})" title="Approve">
                                    <i class="fas fa-check"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger btn-sm-action" onclick="rejectDriver(${d.id})" title="Reject">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                `).join('');
            })
            .catch(err => {
                console.error('Error loading drivers:', err);
