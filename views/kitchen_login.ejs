<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kitchen Staff Login - ET-FOOD</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        body { background: linear-gradient(135deg, #1e293b 0%, #334155 50%, #475569 100%); min-height: 100vh; display: flex; align-items: center; justify-content: center; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
        .login-container { background: rgba(15,23,42,0.9); border-radius: 20px; padding: 3rem; border: 1px solid rgba(59,130,246,0.3); backdrop-filter: blur(10px); box-shadow: 0 25px 50px rgba(0,0,0,0.3); width: 100%; max-width: 400px; }
        .login-header { text-align: center; margin-bottom: 2rem; }
        .login-header h1 { color: #f8fafc; font-size: 2rem; font-weight: 700; margin-bottom: 0.5rem; }
        .login-header p { color: #94a3b8; font-size: 1rem; }
        .brand-icon { background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%); width: 80px; height: 80px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem; font-size: 2rem; color: white; }
        .form-label { color: #f8fafc; font-weight: 600; margin-bottom: 0.5rem; }
        .form-control { background: rgba(30,41,59,0.8); border: 1px solid rgba(59,130,246,0.3); border-radius: 10px; color: #f8fafc; padding: 0.75rem 1rem; margin-bottom: 1rem; }
        .form-control:focus { background: rgba(30,41,59,1); border-color: #3b82f6; color: #f8fafc; box-shadow: 0 0 0 0.2rem rgba(59,130,246,0.25); }
        .form-control::placeholder { color: #64748b; }
        .btn-primary { background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%); border: none; border-radius: 10px; padding: 0.75rem 1.5rem; font-weight: 600; width: 100%; transition: all 0.3s ease; }
        .btn-primary:hover { background: linear-gradient(135deg, #1d4ed8 0%, #1e40af 100%); transform: translateY(-2px); box-shadow: 0 8px 25px rgba(59,130,246,0.3); }
        .alert { border-radius: 10px; border: none; margin-bottom: 1rem; }
        .alert-danger { background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%); color: white; }
        .footer-text { text-align: center; color: #64748b; font-size: 0.9rem; margin-top: 2rem; }
    </style>
</head>
<body>
    <div class="login-container">
        <div class="login-header">
            <div class="brand-icon"><i class="fas fa-utensils"></i></div>
            <h1>Kitchen Staff Login</h1>
            <p>Access the ET-FOOD Kitchen Management System</p>
        </div>
        <% if (message) { %>
        <div class="alert alert-danger">
            <i class="fas fa-exclamation-triangle me-2"></i><%= message %>
        </div>
        <% } %>
        <form method="POST">
            <div class="mb-3">
                <label for="username" class="form-label"><i class="fas fa-user me-2"></i>Username</label>
                <input type="text" class="form-control" id="username" name="username" placeholder="Enter your username" required>
            </div>
            <div class="mb-3">
                <label for="password" class="form-label"><i class="fas fa-lock me-2"></i>Password</label>
                <input type="password" class="form-control" id="password" name="password" placeholder="Enter your password" required>
            </div>
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-sign-in-alt me-2"></i>Login to Kitchen
            </button>
        </form>
        <div class="footer-text">
            <p>ET-FOOD Kitchen Management System<br>Flavour Cafe | E.Fabrica</p>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
