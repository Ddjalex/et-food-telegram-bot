        function togglePasswordVisibility(inputId, button) {
            const input = document.getElementById(inputId);
            const icon = button.querySelector('i');
            
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            }
        }

        function updateStaffPassword(staffId) {
            const newPassword = document.getElementById('newPassword').value;
            const confirmPassword = document.getElementById('confirmPassword').value;
            const notifyStaff = document.getElementById('notifyStaff').checked;
            
            if (!newPassword || !confirmPassword) {
                alert('Please fill in all password fields');
                return;
            }
            
            if (newPassword !== confirmPassword) {
                alert('Passwords do not match');
                return;
            }
            
            if (newPassword.length < 6) {
                alert('Password must be at least 6 characters long');
                return;
            }
            
            fetch(`/api/admin/kitchen-staff/${staffId}/change-password`, {
                method: 'PUT',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    new_password: newPassword,
                    notify_staff: notifyStaff
                })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert('Password changed successfully!');
                    bootstrap.Modal.getInstance(document.getElementById('changePasswordModal')).hide();
                    loadKitchenStaff();
                } else {
                    alert('Error: ' + data.message);
                }
            })
            .catch(error => {
                console.error('Error changing password:', error);
                alert('Error changing password');
            });
        }

        // Kitchen Logo Upload Functionality
        function uploadKitchenLogo() {
            const input = document.createElement('input');
            input.type = 'file';
            input.accept = 'image/*';
            input.style.display = 'none';
            
            input.onchange = function(event) {
                const file = event.target.files[0];
                if (!file) return;
                
                // Validate file type
                if (!file.type.startsWith('image/')) {
                    alert('Please select an image file');
                    return;
                }
                
                // Validate file size (max 5MB)
                if (file.size > 5 * 1024 * 1024) {
                    alert('File size must be less than 5MB');
                    return;
                }
                
                const formData = new FormData();
                formData.append('kitchen_logo', file);
                
                // Show loading state
                const logoImg = document.getElementById('kitchenLogo');
                const originalSrc = logoImg.src;
                logoImg.style.opacity = '0.5';
                
                fetch('/api/admin/upload-kitchen-logo', {
                    method: 'POST',
                    body: formData
                })
                .then(response => response.json())
                .then(data => {
                    logoImg.style.opacity = '1';
                    if (data.success) {
                        logoImg.src = data.image_url + '?t=' + Date.now(); // Cache bust
                        alert('Kitchen logo updated successfully!');
                    } else {
                        logoImg.src = originalSrc;
                        alert('Error: ' + data.message);
                    }
                })
                .catch(error => {
                    logoImg.style.opacity = '1';
                    logoImg.src = originalSrc;
                    console.error('Error uploading kitchen logo:', error);
                    alert('Error uploading kitchen logo');
                });
            };
            
            document.body.appendChild(input);
            input.click();
            document.body.removeChild(input);
        }

        // Edit Kitchen Staff Modal
        function showEditKitchenStaffModal(staffId) {
            // First fetch current staff data
            fetch(`/api/admin/kitchen-staff/${staffId}`)
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    const staff = data.staff;
                    const modalHtml = `
                        <div class="modal fade" id="editKitchenStaffModal" tabindex="-1" data-bs-backdrop="static">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <div class="modal-header bg-primary text-white">
                                        <h5 class="modal-title">
                                            <i class="fas fa-user-edit me-2"></i>Edit Kitchen Staff: ${staff.full_name || staff.username}
                                        </h5>
                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                    </div>
                                    <div class="modal-body">
                                        <form id="editKitchenStaffForm">
                                            <div class="mb-3">
                                                <label for="editStaffName" class="form-label">Full Name *</label>
                                                <input type="text" class="form-control" id="editStaffName" value="${staff.full_name || ''}" required>
                                            </div>
                                            <div class="mb-3">
                                                <label for="editStaffUsername" class="form-label">Username *</label>
                                                <input type="text" class="form-control" id="editStaffUsername" value="${staff.username}" required readonly>
                                                <div class="form-text">Username cannot be changed</div>
                                            </div>
                                            <div class="mb-3">
                                                <label for="editStaffPhone" class="form-label">Phone Number</label>
                                                <input type="text" class="form-control" id="editStaffPhone" value="${staff.phone || ''}">
                                            </div>
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" id="editStaffActive" ${staff.is_active ? 'checked' : ''}>
                                                <label class="form-check-label" for="editStaffActive">
                                                    Active (can access kitchen dashboard)
                                                </label>
                                            </div>
                                        </form>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                        <button type="button" class="btn btn-primary" onclick="updateKitchenStaff(${staffId})">
                                            <i class="fas fa-save me-2"></i>Save Changes
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    `;
                    
                    // Remove existing modal if any
                    const existingModal = document.getElementById('editKitchenStaffModal');
                    if (existingModal) existingModal.remove();
                    
                    document.body.insertAdjacentHTML('beforeend', modalHtml);
                    const modal = new bootstrap.Modal(document.getElementById('editKitchenStaffModal'));
                    modal.show();
                } else {
                    alert('Error loading staff details');
                }
            })
            .catch(error => {
                console.error('Error fetching staff details:', error);
                alert('Error loading staff details');
            });
        }

        function updateKitchenStaff(staffId) {
            const fullName = document.getElementById('editStaffName').value;
            const phone = document.getElementById('editStaffPhone').value;
            const isActive = document.getElementById('editStaffActive').checked;
            
            if (!fullName.trim()) {
                alert('Full name is required');
                return;
            }
            
            fetch(`/api/admin/kitchen-staff/${staffId}`, {
                method: 'PUT',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    full_name: fullName,
                    phone: phone,
                    is_active: isActive
                })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert('Kitchen staff updated successfully!');
                    bootstrap.Modal.getInstance(document.getElementById('editKitchenStaffModal')).hide();
                    loadKitchenStaff();
                } else {
                    alert('Error: ' + data.message);
                }
            })
            .catch(error => {
                console.error('Error updating kitchen staff:', error);
                alert('Error updating kitchen staff');
            });
        }

        // Image Gallery for Menu Item Selection
        function showImageGallery(itemId) {
            console.log('Opening image gallery for item:', itemId);
            
            // Fetch available images from uploads directory
            fetch('/api/admin/uploaded-images')
                .then(response => response.json())
                .then(data => {
                    if (data.success && data.images) {
                        createImageGalleryModal(data.images, itemId);
                    } else {
                        alert('Error loading image gallery');
                    }
                })
                .catch(error => {
                    console.error('Error loading image gallery:', error);
                    alert('Error loading image gallery');
                });
        }

        function createImageGalleryModal(images, itemId) {
            const modalHtml = `
                <div class="modal fade" id="imageGalleryModal" tabindex="-1" data-bs-backdrop="static">
                    <div class="modal-dialog modal-xl">
                        <div class="modal-content">
                            <div class="modal-header bg-primary text-white">
                                <h5 class="modal-title">
                                    <i class="fas fa-images me-2"></i>Choose Image from Gallery
                                </h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <div class="row g-3" id="imageGalleryGrid">
                                    ${images.map(image => `
                                        <div class="col-md-3 col-sm-4 col-6">
                                            <div class="card h-100 image-card" onclick="selectImage('${image.url}', '${itemId}')" 
                                                 style="cursor: pointer; transition: all 0.3s ease;">
                                                <img src="${image.url}" class="card-img-top" 
                                                     style="height: 200px; object-fit: cover;" 
                                                     alt="${image.filename}">
                                                <div class="card-body p-2">
                                                    <small class="text-muted">${image.filename}</small>
                                                </div>
                                            </div>
                                        </div>
                                    `).join('')}
                                </div>
                                ${images.length === 0 ? '<p class="text-center text-muted py-5">No images found in gallery</p>' : ''}
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            </div>
                        </div>
                    </div>
                </div>
            `;
            
            // Remove existing modal if any
            const existingModal = document.getElementById('imageGalleryModal');
            if (existingModal) existingModal.remove();
            
            document.body.insertAdjacentHTML('beforeend', modalHtml);
            
            // Add hover effects
            const imageCards = document.querySelectorAll('.image-card');
            imageCards.forEach(card => {
                card.addEventListener('mouseenter', function() {
                    this.style.transform = 'scale(1.05)';
                    this.style.boxShadow = '0 5px 15px rgba(0,0,0,0.3)';
                });
                card.addEventListener('mouseleave', function() {
                    this.style.transform = 'scale(1)';
                    this.style.boxShadow = '';
                });
            });
            
            const modal = new bootstrap.Modal(document.getElementById('imageGalleryModal'));
            modal.show();
            
            // Clean up modal after close
            document.getElementById('imageGalleryModal').addEventListener('hidden.bs.modal', function() {
                this.remove();
            });
        }

        function selectImage(imageUrl, itemId) {
            console.log('Selected image:', imageUrl, 'for item:', itemId);
            
            // Update the current image preview in the edit modal
            const currentImagePreview = document.querySelector('#editMenuItemModal .img-thumbnail');
            if (currentImagePreview) {
                currentImagePreview.src = imageUrl;
            }
            
            // Set the selected image URL in the hidden field
            const selectedImageField = document.getElementById('selectedImageUrl');
            if (selectedImageField) {
                selectedImageField.value = imageUrl;
            }
            
            // Clear the file input since we're using a selected image
            const fileInput = document.getElementById('editItemImage');
            if (fileInput) {
                fileInput.value = '';
            }
            
            // Close the gallery modal
            const galleryModal = bootstrap.Modal.getInstance(document.getElementById('imageGalleryModal'));
            if (galleryModal) {
                galleryModal.hide();
            }
            
            // Show confirmation
            alert('Image selected successfully!');
        }

        // Auto-refresh functionality
        setInterval(() => {
            if (document.getElementById('dashboard').classList.contains('active')) {
                loadDashboardStats();
                loadRecentOrders();
            }
        }, 60000); // Refresh every minute
    </script>
</body>
</html>