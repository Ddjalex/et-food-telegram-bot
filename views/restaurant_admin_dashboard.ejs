<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= admin.restaurant ? admin.restaurant.name : 'Restaurant' %> - Admin Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * {
            font-family: 'Inter', sans-serif;
        }
        
        body {
            background: #f8fafc;
            color: #334155;
        }
        
        .admin-sidebar {
            min-height: 100vh;
            background: linear-gradient(135deg, #1e293b 0%, #334155 100%);
            box-shadow: 0 0 40px rgba(0,0,0,0.15);
            position: relative;
        }
        
        .admin-sidebar::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 50%, #06b6d4 100%);
            opacity: 0.1;
        }
        
        .admin-main {
            background: #f8fafc;
            min-height: 100vh;
        }
        
        .stat-card {
            background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);
            border: none;
            color: white;
            transition: all 0.3s ease;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(59, 130, 246, 0.3);
        }
        
        .stat-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 40px rgba(59, 130, 246, 0.4);
        }
        
        .stat-card-secondary {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            box-shadow: 0 10px 30px rgba(16, 185, 129, 0.3);
        }
        
        .stat-card-warning {
            background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
            box-shadow: 0 10px 30px rgba(245, 158, 11, 0.3);
        }
        
        .stat-card-danger {
            background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
            box-shadow: 0 10px 30px rgba(239, 68, 68, 0.3);
        }
        
        .nav-pills .nav-link {
            color: rgba(255,255,255,0.8);
            border-radius: 15px;
            margin-bottom: 8px;
            transition: all 0.3s ease;
            padding: 12px 20px;
            font-weight: 500;
            position: relative;
            z-index: 2;
        }
        
        .nav-pills .nav-link.active {
            background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);
            color: white;
            box-shadow: 0 5px 15px rgba(59, 130, 246, 0.4);
        }
        
        .nav-pills .nav-link:hover {
            background: rgba(255,255,255,0.1);
            color: white;
            transform: translateX(5px);
        }
        
        .table-container {
            background: white;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
            overflow: hidden;
            border: 1px solid rgba(226, 232, 240, 0.8);
        }
        
        .admin-header {
            background: linear-gradient(135deg, #1e293b 0%, #334155 100%);
            color: white;
            border-radius: 0 0 30px 30px;
            margin-bottom: 30px;
            position: relative;
            overflow: hidden;
        }
        
        .admin-header::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 50%, #06b6d4 100%);
            opacity: 0.1;
        }
        
        .admin-header > * {
            position: relative;
            z-index: 2;
        }
        
        .tab-pane {
            display: none;
        }
        
        .tab-pane.active {
            display: block;
        }
        
        .card-header {
            background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
            border-bottom: 2px solid #e2e8f0;
            font-weight: 600;
            color: #1e293b;
        }
        
        .btn-primary {
            background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);
            border: none;
            border-radius: 10px;
            font-weight: 500;
            padding: 10px 20px;
            transition: all 0.3s ease;
        }
        
        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(59, 130, 246, 0.3);
        }
        
        .btn-light {
            background: white;
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            color: #64748b;
            font-weight: 500;
        }
        
        .btn-light:hover {
            background: #f1f5f9;
            border-color: #cbd5e1;
        }
        
        .table th {
            background: #f8fafc;
            color: #475569;
            font-weight: 600;
            border: none;
            padding: 15px;
        }
        
        .table td {
            padding: 15px;
            border-color: #f1f5f9;
        }
        
        .table-hover tbody tr:hover {
            background: rgba(59, 130, 246, 0.05);
        }
        
        .badge {
            font-weight: 500;
            padding: 6px 12px;
            border-radius: 8px;
        }
        
        .analytics-card {
            background: white;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
            border: 1px solid rgba(226, 232, 240, 0.8);
            transition: all 0.3s ease;
        }
        
        .analytics-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.12);
        }
        
        .chart-container {
            position: relative;
            height: 350px;
            padding: 20px;
        }
        
        .brand-logo {
            font-size: 1.5rem;
            font-weight: 700;
            background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        
        .user-avatar {
            width: 60px;
            height: 60px;
            background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 15px;
            font-size: 1.5rem;
            color: white;
            font-weight: 600;
        }
        
        .sidebar-brand {
            padding: 30px 20px;
            text-align: center;
            border-bottom: 1px solid rgba(255,255,255,0.1);
            margin-bottom: 30px;
        }
        
        .sidebar-user {
            padding: 0 20px 30px;
            text-align: center;
            border-bottom: 1px solid rgba(255,255,255,0.1);
            margin-bottom: 30px;
        }
        
        .sidebar-nav {
            padding: 0 20px;
        }
        
        .sidebar-footer {
            position: absolute;
            bottom: 30px;
            left: 20px;
            right: 20px;
        }
        
        .status-indicator {
            display: inline-block;
            width: 8px;
            height: 8px;
            border-radius: 50%;
            margin-right: 8px;
        }
        
        .status-active { background: #10b981; }
        .status-pending { background: #f59e0b; }
        .status-danger { background: #ef4444; }
        
        .quick-actions {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
        }
        
        .quick-action {
            flex: 1;
            padding: 15px;
            background: white;
            border: 1px solid #e2e8f0;
            border-radius: 15px;
            text-align: center;
            text-decoration: none;
            color: #64748b;
            transition: all 0.3s ease;
        }
        
        .quick-action:hover {
            background: #f8fafc;
            border-color: #3b82f6;
            color: #3b82f6;
            transform: translateY(-2px);
        }
        
        .dashboard-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }
        
        .performance-indicator {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 15px;
            background: #f8fafc;
            border-radius: 10px;
            margin-top: 10px;
        }
        
        .performance-indicator.positive { background: #f0fdf4; color: #166534; }
        .performance-indicator.negative { background: #fef2f2; color: #991b1b; }
        
        .metric-change {
            font-size: 0.875rem;
            font-weight: 500;
        }
        
        .dropdown-menu {
            border: none;
            box-shadow: 0 10px 30px rgba(0,0,0,0.15);
            border-radius: 15px;
        }
        
        .dropdown-item {
            padding: 10px 20px;
            transition: all 0.3s ease;
        }
        
        .dropdown-item:hover {
            background: #f8fafc;
            color: #3b82f6;
        }
    </style>
</head>
<body>
    <div class="container-fluid p-0">
        <div class="row g-0">
            <!-- Sidebar -->
            <div class="col-md-3 col-lg-2 admin-sidebar">
                <div class="sidebar-brand">
                    <div class="brand-logo">
                        <i class="fas fa-utensils me-2"></i>
                        ET-FOOD
                    </div>
                    <div class="text-white-50 mt-2">Restaurant Admin</div>
                </div>
                
                <div class="sidebar-user">
                    <div class="user-avatar">
                        <%= admin.full_name ? admin.full_name[0] : 'A' %>
                    </div>
                    <h6 class="text-white mb-1"><%= admin.full_name %></h6>
                    <small class="text-white-50"><%= admin.restaurant ? admin.restaurant.name : 'No Restaurant' %></small>
                    <div class="performance-indicator positive mt-2">
                        <div class="status-indicator status-active"></div>
                        <small>Online</small>
                    </div>
                </div>
                
                <nav class="nav nav-pills flex-column sidebar-nav">
                    <a class="nav-link active" data-bs-toggle="pill" href="#dashboard">
                        <i class="fas fa-tachometer-alt me-2"></i>
                        Dashboard
                    </a>
                    <a class="nav-link" data-bs-toggle="pill" href="#orders">
                        <i class="fas fa-shopping-bag me-2"></i>
                        Orders
                    </a>

                    <a class="nav-link" data-bs-toggle="pill" href="#menu">
                        <i class="fas fa-utensils me-2"></i>
                        Menu Management
                    </a>
                    <a class="nav-link" data-bs-toggle="pill" href="#categories">
                        <i class="fas fa-tags me-2"></i>
                        Categories
                    </a>
                    <% if (admin.role === 'super_admin' || (admin.role === 'admin' && admin.is_approved)) { %>
                    <a class="nav-link" data-bs-toggle="pill" href="#drivers">
                        <i class="fas fa-motorcycle me-2"></i>
                        Drivers
                    </a>
                    <% } %>
                    <a class="nav-link" data-bs-toggle="pill" href="#analytics">
                        <i class="fas fa-chart-line me-2"></i>
                        Analytics
                    </a>
                    <a class="nav-link" data-bs-toggle="pill" href="#kitchen-staff">
                        <i class="fas fa-users me-2"></i>
                        Kitchen Staff
                    </a>
                    <a class="nav-link" data-bs-toggle="pill" href="#settings">
                        <i class="fas fa-cog me-2"></i>
                        Settings
                    </a>
                </nav>
                
                <div class="sidebar-footer">
                    <a href="/admin/logout" class="btn btn-outline-light btn-sm w-100">
                        <i class="fas fa-sign-out-alt me-2"></i>
                        Logout
                    </a>
                </div>
            </div>
            
            <!-- Main Content -->
            <div class="col-md-9 col-lg-10 admin-main">
                <!-- Header -->
                <div class="admin-header p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h2 class="mb-1"><%= admin.restaurant ? admin.restaurant.name : 'Restaurant' %> Dashboard</h2>
                            <p class="mb-0 opacity-75" id="currentDateTime"></p>
                        </div>
                        <div class="d-flex gap-2">
                            <button class="btn btn-light" id="exportOrdersBtn">
                                <i class="fas fa-download me-1"></i> Export
                            </button>
                            <button class="btn btn-light" id="refreshBtn">
                                <i class="fas fa-sync me-1"></i> Refresh
                            </button>
                            <div class="dropdown">
                                <button class="btn btn-light dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                    <i class="fas fa-user-circle me-1"></i> <%= admin.full_name %>
                                </button>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" href="#"><i class="fas fa-user me-2"></i>Profile</a></li>
                                    <li><a class="dropdown-item" href="#"><i class="fas fa-cog me-2"></i>Settings</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" href="/admin/logout"><i class="fas fa-sign-out-alt me-2"></i>Logout</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Content Area -->
                <div class="p-4">
                    <div class="tab-content" id="adminTabsContent">
                        <!-- Dashboard Tab -->
                        <div class="tab-pane fade show active" id="dashboard" role="tabpanel">
                            <!-- Quick Actions -->
                            <div class="quick-actions">
                                <a href="#" class="quick-action" onclick="switchToTab('orders')">
                                    <i class="fas fa-plus-circle fa-2x mb-2"></i>
                                    <div>New Order</div>
                                </a>
                                <a href="#" class="quick-action" onclick="switchToTab('menu')">
                                    <i class="fas fa-utensils fa-2x mb-2"></i>
                                    <div>Menu</div>
                                </a>
                                <a href="#" class="quick-action" onclick="switchToTab('analytics')">
                                    <i class="fas fa-chart-line fa-2x mb-2"></i>
                                    <div>Analytics</div>
                                </a>
                                <% if (admin.role === 'super_admin' || (admin.role === 'admin' && admin.is_approved)) { %>
                                <a href="#" class="quick-action" onclick="switchToTab('drivers')">
                                    <i class="fas fa-motorcycle fa-2x mb-2"></i>
                                    <div>Drivers</div>
                                </a>
                                <% } %>
                            </div>
                            
                            <!-- Stats Cards -->
                            <div class="row mb-4">
                                <div class="col-md-3 mb-3">
                                    <div class="card stat-card h-100">
                                        <div class="card-body text-center">
                                            <i class="fas fa-shopping-bag fa-3x mb-3"></i>
                                            <h2 class="mb-1" id="totalOrders">0</h2>
                                            <p class="mb-0">Today's Orders</p>
                                            <div class="performance-indicator positive">
                                                <i class="fas fa-arrow-up"></i>
                                                <span class="metric-change">+12%</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-3 mb-3">
                                    <div class="card stat-card stat-card-secondary h-100">
                                        <div class="card-body text-center">
                                            <i class="fas fa-dollar-sign fa-3x mb-3"></i>
                                            <h2 class="mb-1" id="totalRevenue">ETB 0</h2>
                                            <p class="mb-0">Today's Revenue</p>
                                            <div class="performance-indicator positive">
                                                <i class="fas fa-arrow-up"></i>
                                                <span class="metric-change">+8%</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-3 mb-3">
                                    <div class="card stat-card stat-card-warning h-100">
                                        <div class="card-body text-center">
                                            <i class="fas fa-clock fa-3x mb-3"></i>
                                            <h2 class="mb-1" id="pendingOrders">0</h2>
                                            <p class="mb-0">Pending Orders</p>
                                            <div class="performance-indicator negative">
                                                <i class="fas fa-arrow-down"></i>
                                                <span class="metric-change">-5%</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-3 mb-3">
                                    <div class="card stat-card stat-card-danger h-100">
                                        <div class="card-body text-center">
                                            <i class="fas fa-motorcycle fa-3x mb-3"></i>
                                            <h2 class="mb-1" id="activeDrivers">0</h2>
                                            <p class="mb-0">Active Drivers</p>
                                            <div class="performance-indicator positive">
                                                <i class="fas fa-arrow-up"></i>
                                                <span class="metric-change">+2 New</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Charts Row -->
                            <div class="dashboard-grid">
                                <div class="analytics-card">
                                    <div class="card-header">
                                        <h5 class="mb-0">
                                            <i class="fas fa-chart-line me-2"></i>
                                            Sales Overview
                                        </h5>
                                    </div>
                                    <div class="chart-container">
                                        <canvas id="salesChart"></canvas>
                                    </div>
                                </div>
                                <div class="analytics-card">
                                    <div class="card-header">
                                        <h5 class="mb-0">
                                            <i class="fas fa-chart-pie me-2"></i>
                                            Order Status
                                        </h5>
                                    </div>
                                    <div class="chart-container">
                                        <canvas id="statusChart"></canvas>
                                    </div>
                                </div>
                            </div>

                            <!-- Recent Orders -->
                            <div class="card table-container">
                                <div class="card-header d-flex justify-content-between align-items-center">
                                    <h5 class="mb-0">Recent Orders</h5>
                                    <button class="btn btn-primary btn-sm" onclick="switchToTab('orders')">
                                        View All Orders
                                    </button>
                                </div>
                                <div class="card-body p-0">
                                    <div class="table-responsive">
                                        <table class="table table-hover mb-0">
                                            <thead class="table-dark">
                                                <tr>
                                                    <th>Order ID</th>
                                                    <th>Customer</th>
                                                    <th>Items</th>
                                                    <th>Status</th>
                                                    <th>Total</th>
                                                    <th>Time</th>
                                                </tr>
                                            </thead>
                                            <tbody id="recentOrdersTable">
                                                <tr>
                                                    <td colspan="6" class="text-center py-4">
                                                        <div class="spinner-border text-primary" role="status">
                                                            <span class="visually-hidden">Loading...</span>
                                                        </div>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Orders Management Tab -->
                        <div class="tab-pane fade" id="orders" role="tabpanel">
                            <div class="card table-container">
                                <div class="card-header d-flex justify-content-between align-items-center">
                                    <h5 class="mb-0">Orders Management</h5>
                                    <div class="d-flex gap-2">
                                        <select class="form-select" id="statusFilter" onchange="loadOrders(1, this.value)">
                                            <option value="all">All Status</option>
                                            <option value="pending">Pending</option>
                                            <option value="confirmed">Confirmed</option>
                                            <option value="preparing">Preparing</option>
                                            <option value="ready">Ready</option>
                                            <option value="out_for_delivery">Out for Delivery</option>
                                            <option value="delivered">Delivered</option>
                                            <option value="cancelled">Cancelled</option>
                                        </select>
                                        <button class="btn btn-primary btn-sm" onclick="loadOrders(1, 'all')">
                                            <i class="fas fa-sync me-1"></i> Refresh
                                        </button>
                                    </div>
                                </div>
                                <div class="card-body p-0">
                                    <div class="table-responsive">
                                        <table class="table table-hover mb-0">
                                            <thead class="table-dark">
                                                <tr>
                                                    <th>Order ID</th>
                                                    <th>Customer</th>
                                                    <th>Items</th>
                                                    <th>Status</th>
                                                    <th>Payment</th>
                                                    <th>Total</th>
                                                    <th>Time</th>
                                                    <th>Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody id="ordersTable">
                                                <tr>
                                                    <td colspan="8" class="text-center py-4">
                                                        <div class="spinner-border text-primary" role="status">
                                                            <span class="visually-hidden">Loading...</span>
                                                        </div>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>


                        <!-- Menu Management Tab -->
                        <div class="tab-pane fade" id="menu" role="tabpanel">
                            <div class="card table-container">
                                <div class="card-header d-flex justify-content-between align-items-center">
                                    <h5 class="mb-0">Menu Management</h5>
                                    <button class="btn btn-primary btn-sm" onclick="showAddMenuItemModal()">
                                        <i class="fas fa-plus me-1"></i> Add New Item
                                    </button>
                                </div>
                                <div class="card-body p-0">
                                    <div class="table-responsive">
                                        <table class="table table-hover mb-0">
                                            <thead class="table-dark">
                                                <tr>
                                                    <th>Image</th>
                                                    <th>Name</th>
                                                    <th>Category</th>
                                                    <th>Price</th>
                                                    <th>Status</th>
                                                    <th>Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody id="menuItemsTable">
                                                <tr>
                                                    <td colspan="6" class="text-center py-4">
                                                        <div class="spinner-border text-primary" role="status">
                                                            <span class="visually-hidden">Loading...</span>
                                                        </div>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Categories Tab -->
                        <div class="tab-pane fade" id="categories" role="tabpanel">
                            <div class="card table-container">
                                <div class="card-header d-flex justify-content-between align-items-center">
                                    <h5 class="mb-0">Categories Management</h5>
                                    <button class="btn btn-primary btn-sm" id="addCategoryBtn">
                                        <i class="fas fa-plus me-1"></i> Add Category
                                    </button>
                                </div>
                                <div class="card-body p-0">
                                    <div class="table-responsive">
                                        <table class="table table-hover mb-0">
                                            <thead class="table-dark">
                                                <tr>
                                                    <th>Icon</th>
                                                    <th>Name</th>
                                                    <th>Description</th>
                                                    <th>Items Count</th>
                                                    <th>Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody id="categoriesTable">
                                                <tr>
                                                    <td colspan="5" class="text-center py-4">
                                                        <div class="spinner-border text-primary" role="status">
                                                            <span class="visually-hidden">Loading...</span>
                                                        </div>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Drivers Tab -->
                        <% if (admin.role === 'super_admin' || (admin.role === 'admin' && admin.is_approved)) { %>
                        <div class="tab-pane fade" id="drivers" role="tabpanel">
                            <div class="card table-container">
                                <div class="card-header d-flex justify-content-between align-items-center">
                                    <h5 class="mb-0">Drivers Management</h5>
                                    <button class="btn btn-primary btn-sm" id="addDriverBtn">
                                        <i class="fas fa-plus me-1"></i> Add Driver
                                    </button>
                                </div>
                                <div class="card-body p-0">
                                    <div class="table-responsive">
                                        <table class="table table-hover mb-0">
                                            <thead class="table-dark">
                                                <tr>
                                                    <th>Name</th>
                                                    <th>Phone</th>
                                                    <th>Vehicle</th>
                                                    <th>Status</th>
                                                    <th>Active</th>
                                                    <th>Location Status</th>
                                                    <th>Documents</th>
                                                    <th>Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody id="driversTable">
                                                <tr>
                                                    <td colspan="8" class="text-center py-4">
                                                        <div class="spinner-border text-primary" role="status">
                                                            <span class="visually-hidden">Loading...</span>
                                                        </div>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <% } %>

                        <!-- Analytics Tab -->
                        <div class="tab-pane fade" id="analytics" role="tabpanel">
                            <div class="row mb-4">
                                <div class="col-md-6">
                                    <div class="card table-container">
                                        <div class="card-header">
                                            <h5 class="mb-0">Daily Sales</h5>
                                        </div>
                                        <div class="card-body">
                                            <canvas id="dailySalesChart"></canvas>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="card table-container">
                                        <div class="card-header">
                                            <h5 class="mb-0">Popular Items</h5>
                                        </div>
                                        <div class="card-body">
                                            <canvas id="popularItemsChart"></canvas>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Kitchen Staff Tab -->
                        <div class="tab-pane fade" id="kitchen-staff" role="tabpanel">
                            <div class="row">
                                <div class="col-12">
                                    <div class="card">
                                        <div class="card-header d-flex justify-content-between align-items-center">
                                            <div class="d-flex align-items-center">
                                                <div class="kitchen-logo-container me-3">
                                                    <img id="kitchenLogo" src="/static/uploads/kitchen_logo.svg" alt="Kitchen" 
                                                         class="rounded-circle" style="width: 40px; height: 40px; object-fit: cover;" 
                                                         onerror="this.src='data:image/svg+xml;base64,'">
                                                    <button class="btn btn-sm btn-outline-secondary position-absolute" 
                                                            style="top: -5px; right: -5px; width: 20px; height: 20px; border-radius: 50%; padding: 0; font-size: 10px;"
                                                            onclick="uploadKitchenLogo()" title="Change Kitchen Logo">
                                                        <i class="fas fa-camera"></i>
                                                    </button>
                                                </div>
                                                <h5 class="mb-0"><i class="fas fa-users me-2"></i>Kitchen Staff Management</h5>
                                            </div>
                                            <button class="btn btn-primary" onclick="showAddKitchenStaffModal()">
                                                <i class="fas fa-plus me-2"></i>Add Kitchen Staff
                                            </button>
                                        </div>
                                        <div class="card-body">
                                            <div class="table-responsive">
                                                <table class="table table-striped">
                                                    <thead>
                                                        <tr>
                                                            <th>Photo</th>
                                                            <th>Name</th>
                                                            <th>Username</th>
                                                            <th>Phone</th>
                                                            <th>Status</th>
                                                            <th>Created</th>
                                                            <th>Actions</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody id="kitchenStaffTable">
                                                        <tr>
                                                            <td colspan="7" class="text-center py-4">Loading kitchen staff...</td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Settings Tab -->
                        <div class="tab-pane fade" id="settings" role="tabpanel">
                            <div class="card table-container">
                                <div class="card-header">
                                    <h5 class="mb-0">Restaurant Settings</h5>
                                </div>
                                <div class="card-body">
                                    <form id="settingsForm">
                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="mb-3">
                                                    <label class="form-label">Delivery Radius (km)</label>
                                                    <input type="number" class="form-control" id="deliveryRadius" value="10">
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="mb-3">
                                                    <label class="form-label">Minimum Order Amount (ETB)</label>
                                                    <input type="number" class="form-control" id="minOrderAmount" value="50">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="mb-3">
                                                    <label class="form-label">Delivery Fee (ETB)</label>
                                                    <input type="number" class="form-control" id="deliveryFee" value="15">
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="mb-3">
                                                    <label class="form-label">Service Hours</label>
                                                    <input type="text" class="form-control" id="serviceHours" value="8:00 AM - 11:00 PM">
                                                </div>
                                            </div>
                                        </div>
                                        <button type="submit" class="btn btn-primary">Save Settings</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Initialize dashboard data
        let ordersData = [];
        let currentPage = 1;
        let currentStatus = 'all';
        
        // Update current date/time
        function updateDateTime() {
            const now = new Date();
            document.getElementById('currentDateTime').textContent = now.toLocaleString();
        }
        
        setInterval(updateDateTime, 1000);
        updateDateTime();

        // Initialize when page loads
        document.addEventListener('DOMContentLoaded', function() {
            initializeDashboard();
            setupEventListeners();
            setupTabSwitching();
            loadMenuItems();
            loadCategories();
            loadDrivers();
            loadKitchenStaff(); // Load kitchen staff on page load
        });

        function initializeDashboard() {
            loadDashboardStats();
            loadRecentOrders();
            initializeCharts();
        }
        
        function initializeCharts() {
            // Check if Chart is available
            if (typeof Chart === 'undefined') {
                console.error('Chart.js is not loaded');
                return;
            }
            
            // Initialize Sales Chart
            const salesCtx = document.getElementById('salesChart').getContext('2d');
            new Chart(salesCtx, {
                type: 'line',
                data: {
                    labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
                    datasets: [{
                        label: 'Sales (ETB)',
                        data: [1200, 1900, 1500, 2100, 1800, 2500, 2200],
                        borderColor: 'rgb(59, 130, 246)',
                        backgroundColor: 'rgba(59, 130, 246, 0.1)',
                        fill: true,
                        tension: 0.4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: false
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: {
                                color: 'rgba(0,0,0,0.1)'
                            }
                        },
                        x: {
                            grid: {
                                display: false
                            }
                        }
                    }
                }
            });
            
            // Initialize Status Chart
            const statusCtx = document.getElementById('statusChart').getContext('2d');
            new Chart(statusCtx, {
                type: 'doughnut',
                data: {
                    labels: ['Pending', 'Preparing', 'Ready', 'Delivered'],
                    datasets: [{
                        data: [12, 8, 5, 25],
                        backgroundColor: [
                            'rgb(245, 158, 11)',
                            'rgb(59, 130, 246)',
                            'rgb(16, 185, 129)',
                            'rgb(34, 197, 94)'
                        ],
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                usePointStyle: true,
                                padding: 20
                            }
                        }
                    }
                }
            });
        }

        function setupEventListeners() {
            document.getElementById('refreshBtn').addEventListener('click', initializeDashboard);
            document.getElementById('exportOrdersBtn').addEventListener('click', exportOrders);
            
            // Settings form
            document.getElementById('settingsForm').addEventListener('submit', function(e) {
                e.preventDefault();
                saveSettings();
            });
        }

        function setupTabSwitching() {
            const tabLinks = document.querySelectorAll('[data-bs-toggle="pill"]');
            tabLinks.forEach(link => {
                link.addEventListener('shown.bs.tab', function(e) {
                    const targetTab = e.target.getAttribute('href');
                    
                    // Load specific data for tabs
                    if (targetTab === '#menu') {
                        setTimeout(() => loadMenuItems(), 100);
                    } else if (targetTab === '#categories') {
                        setTimeout(() => loadCategories(), 100);
                    } else if (targetTab === '#drivers') {
                        setTimeout(() => loadDrivers(), 100);
                    } else if (targetTab === '#orders') {
                        setTimeout(() => loadOrders(1, 'all'), 100);
                        setTimeout(() => loadKitchenStaff(), 100);
                    } else if (targetTab === '#dashboard') {
                        setTimeout(() => {
                            loadDashboardStats();
                            loadRecentOrders();
                        }, 100);
                    }
                });
            });
        }

        function loadDashboardStats() {
            console.log('Loading dashboard stats...');
            fetch('/api/admin/dashboard-stats')
                .then(response => {
                    console.log('Dashboard stats response:', response.status);
                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }
                    return response.json();
                })
                .then(data => {
                    console.log('Dashboard stats data:', data);
                    document.getElementById('totalOrders').textContent = data.todayOrders || 0;
                    document.getElementById('totalRevenue').textContent = `ETB ${data.todayRevenue || 0}`;
                    document.getElementById('pendingOrders').textContent = data.pendingOrders || 0;
                    document.getElementById('activeDrivers').textContent = data.menuItems || 0;
                })
                .catch(error => {
                    console.error('Error loading dashboard stats:', error);
                    // Show error in UI
                    document.getElementById('totalOrders').textContent = 'Error';
                    document.getElementById('totalRevenue').textContent = 'Error';
                    document.getElementById('pendingOrders').textContent = 'Error';
                    document.getElementById('activeDrivers').textContent = 'Error';
                });
        }

        function loadRecentOrders() {
            console.log('Loading recent orders...');
            fetch('/api/admin/recent-orders')
                .then(response => {
                    console.log('Recent orders response status:', response.status);
                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }
                    return response.json();
                })
                .then(data => {
                    console.log('Recent orders data received:', data);
                    // The API returns an array directly, not wrapped in an object
                    const orders = Array.isArray(data) ? data : (data.orders || []);
                    const tableBody = document.getElementById('recentOrdersTable');
                    
                    console.log('Processing recent orders:', orders.length);
                    
                    if (orders.length === 0) {
                        tableBody.innerHTML = '<tr><td colspan="6" class="text-center py-4">No recent orders found</td></tr>';
                        return;
                    }
                    
                    tableBody.innerHTML = orders.slice(0, 10).map(order => {
                        console.log('Processing recent order:', order);
                        return `
                        <tr>
                            <td>#${order.id}</td>
                            <td>${order.customer_name}</td>
                            <td>${order.items ? order.items.length : 0} items</td>
                            <td><span class="badge ${getStatusBadgeClass(order.status)}">${order.status}</span></td>
                            <td>ETB ${order.total_amount}</td>
                            <td>${formatTime(order.created_at)}</td>
                        </tr>
                        `;
                    }).join('');
                })
                .catch(error => {
                    console.error('Error loading recent orders:', error);
                    document.getElementById('recentOrdersTable').innerHTML = '<tr><td colspan="6" class="text-center py-4 text-danger">Error loading orders</td></tr>';
                });
        }

        function loadOrders(page = 1, status = 'all') {
            console.log('Loading orders with status:', status);
            const params = new URLSearchParams({ page, status });
            
            fetch(`/api/admin/orders?${params}`)
                .then(response => {
                    console.log('Orders response status:', response.status);
                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }
                    return response.json();
                })
                .then(data => {
                    console.log('Orders data received:', data);
                    // The API returns an array directly, not wrapped in an object
                    const orders = Array.isArray(data) ? data : (data.orders || []);
                    const tableBody = document.getElementById('ordersTable');
                    
                    console.log('Processing orders:', orders.length);
                    
                    if (orders.length === 0) {
                        tableBody.innerHTML = '<tr><td colspan="8" class="text-center py-4">No orders found</td></tr>';
                        return;
                    }
                    
                    tableBody.innerHTML = orders.map(order => {
                        console.log('Processing order:', order);
                        return `
                        <tr>
                            <td>#${order.id}</td>
                            <td>${order.customer_name}</td>
                            <td>${order.items ? order.items.length : 0} items</td>
                            <td><span class="badge ${getStatusBadgeClass(order.status)}">${order.status}</span></td>
                            <td><span class="badge bg-info">${order.payment_method || 'N/A'}</span></td>
                            <td>ETB ${order.total_amount}</td>
                            <td>${formatTime(order.created_at)}</td>
                            <td>
                                <div class="btn-group" role="group">
                                    <button class="btn btn-sm btn-outline-primary" onclick="viewOrder(${order.id})">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-success" onclick="updateOrderStatus(${order.id}, 'confirmed')">
                                        <i class="fas fa-check"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                        `;
                    }).join('');
                })
                .catch(error => {
                    console.error('Error loading orders:', error);
                    document.getElementById('ordersTable').innerHTML = '<tr><td colspan="8" class="text-center py-4 text-danger">Error loading orders</td></tr>';
                });
        }

        function loadMenuItems() {
            console.log('Loading menu items...');
            fetch('/api/admin/menu-items')
                .then(response => {
                    console.log('Menu items response:', response.status);
                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }
                    return response.json();
                })
                .then(data => {
                    console.log('Menu items data:', data);
                    const items = Array.isArray(data) ? data : (data.items || []);
                    const tableBody = document.getElementById('menuItemsTable');
                    
                    if (items.length === 0) {
                        tableBody.innerHTML = '<tr><td colspan="6" class="text-center py-4">No menu items found</td></tr>';
                        return;
                    }
                    
                    tableBody.innerHTML = items.map(item => `
                        <tr>
                            <td>
                                <img src="${item.image_url || '/static/images/default-food.png'}" 
                                     class="img-fluid rounded" 
                                     style="width: 50px; height: 50px; object-fit: cover;">
                            </td>
                            <td>${item.name}</td>
                            <td>${item.category_name}</td>
                            <td>ETB ${item.price}</td>
                            <td>
                                <span class="badge ${item.is_available ? 'bg-success' : 'bg-danger'}">
                                    ${item.is_available ? 'Available' : 'Unavailable'}
                                </span>
                            </td>
                            <td>
                                <div class="btn-group" role="group">
                                    <button class="btn btn-sm btn-outline-primary" onclick="editMenuItem(${item.id})">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger" onclick="deleteMenuItem(${item.id})">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    `).join('');
                })
                .catch(error => {
                    console.error('Error loading menu items:', error);
                    document.getElementById('menuItemsTable').innerHTML = '<tr><td colspan="6" class="text-center py-4 text-danger">Error loading menu items</td></tr>';
                });
        }

        function loadCategories() {
            fetch('/api/admin/categories')
                .then(response => response.json())
                .then(data => {
                    const categories = Array.isArray(data) ? data : (data.categories || []);
                    const tableBody = document.getElementById('categoriesTable');
                    
                    if (categories.length === 0) {
                        tableBody.innerHTML = '<tr><td colspan="5" class="text-center py-4">No categories found</td></tr>';
                        return;
                    }
                    
                    tableBody.innerHTML = categories.map(category => `
                        <tr>
                            <td><span style="font-size: 1.5rem;">${category.icon || '🍽️'}</span></td>
                            <td>${category.name}</td>
                            <td>${category.description || 'No description'}</td>
                            <td>${category.item_count || 0}</td>
                            <td>
                                <div class="btn-group" role="group">
                                    <button class="btn btn-sm btn-outline-primary" onclick="editCategory(${category.id})">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger" onclick="deleteCategory(${category.id})">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    `).join('');
                })
                .catch(error => {
                    console.error('Error loading categories:', error);
                    document.getElementById('categoriesTable').innerHTML = '<tr><td colspan="5" class="text-center py-4 text-danger">Error loading categories</td></tr>';
                });
        }

        function loadDrivers() {
            fetch('/api/admin/drivers')
                .then(response => response.json())
                .then(data => {
                    const drivers = Array.isArray(data) ? data : [];
                    const tableBody = document.getElementById('driversTable');
                    
                    if (drivers.length === 0) {
                        tableBody.innerHTML = '<tr><td colspan="8" class="text-center py-4">No drivers found</td></tr>';
                        return;
                    }
                    
                    tableBody.innerHTML = drivers.map(driver => {
                        // Format location status properly
                        let locationStatus = 'No Location';
                        let locationClass = 'text-danger';
                        
                        if (driver.location_status) {
                            switch(driver.location_status) {
                                case 'live':
                                    locationStatus = 'Live';
                                    locationClass = 'text-success';
                                    break;
                                case 'active':
                                    locationStatus = 'Active';
                                    locationClass = 'text-primary';
                                    break;
                                case 'recent':
                                    locationStatus = 'Recent';
                                    locationClass = 'text-warning';
                                    break;
                                default:
                                    locationStatus = 'Inactive';
                                    locationClass = 'text-danger';
                            }
                        }
                        
                        return `
                        <tr>
                            <td>${driver.full_name || driver.name}</td>
                            <td>${driver.phone || driver.phone_number}</td>
                            <td>${driver.vehicle_type || 'N/A'}</td>
                            <td>
                                <span class="badge ${driver.status === 'approved' || driver.approval_status === 'approved' ? 'bg-success' : 
                                    (driver.status === 'pending' || driver.approval_status === 'pending') ? 'bg-warning' : 'bg-danger'}">
                                    ${driver.status || driver.approval_status}
                                </span>
                            </td>
                            <td>
                                <span class="badge ${driver.is_active ? 'bg-success' : 'bg-secondary'}">
                                    ${driver.is_active ? 'Active' : 'Inactive'}
                                </span>
                                <br>
                                <small class="${driver.availability_class || (driver.is_available ? 'text-success' : 'text-warning')}">
                                    <i class="fas fa-circle me-1"></i>${driver.availability_status || (driver.is_available ? 'AVAILABLE' : 'BUSY')}
                                </small>
                            </td>
                            <td>
                                <span class="${locationClass}">
                                    <i class="fas fa-circle me-1"></i>${locationStatus}
                                </span>
                                <br>
                                <small class="text-muted">${driver.last_update_text || 'Never'}</small>
                            </td>
                            <td>
                                <button class="btn btn-sm btn-outline-info" onclick="viewDriverDocuments(${driver.id})">
                                    <i class="fas fa-file-alt"></i> View
                                </button>
                            </td>
                            <td>
                                <div class="btn-group" role="group">
                                    <button class="btn btn-sm btn-outline-primary" onclick="editDriver(${driver.id})">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger" onclick="deleteDriver(${driver.id})">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                        `;
                    }).join('');
                })
                .catch(error => {
                    console.error('Error loading drivers:', error);
                    document.getElementById('driversTable').innerHTML = '<tr><td colspan="8" class="text-center py-4 text-danger">Error loading drivers</td></tr>';
                });
        }

        // Helper functions
        function getStatusBadgeClass(status) {
            const classes = {
                'pending': 'bg-warning',
                'confirmed': 'bg-info',
                'preparing': 'bg-primary',
                'ready': 'bg-success',
                'out_for_delivery': 'bg-warning',
                'delivered': 'bg-success',
                'cancelled': 'bg-danger'
            };
            return classes[status] || 'bg-secondary';
        }



        function switchToTab(tabName) {
            const tabLink = document.querySelector(`[href="#${tabName}"]`);
            if (tabLink) {
                const tabTrigger = new bootstrap.Tab(tabLink);
                tabTrigger.show();
            }
        }

        // Menu Management Functions
        function showAddMenuItemModal() {
            const modalHtml = `
                <div class="modal fade" id="addMenuItemModal" tabindex="-1" data-bs-backdrop="static">
                    <div class="modal-dialog modal-lg">
                        <div class="modal-content">
                            <div class="modal-header bg-primary text-white">
                                <h5 class="modal-title">
                                    <i class="fas fa-plus me-2"></i>Add New Menu Item
                                </h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <form id="addMenuItemForm" enctype="multipart/form-data">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="mb-3">
                                                <label for="itemName" class="form-label">Item Name *</label>
                                                <input type="text" class="form-control" id="itemName" name="name" required>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="mb-3">
                                                <label for="itemPrice" class="form-label">Price (ETB) *</label>
                                                <input type="number" class="form-control" id="itemPrice" name="price" step="0.01" required>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="mb-3">
                                        <label for="itemDescription" class="form-label">Description</label>
                                        <textarea class="form-control" id="itemDescription" name="description" rows="3"></textarea>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="mb-3">
                                                <label for="itemCategory" class="form-label">Category *</label>
                                                <select class="form-control" id="itemCategory" name="category" required>
                                                    <option value="">Select Category</option>
                                                    <option value="Burgers">Burgers</option>
                                                    <option value="Shawarma">Shawarma</option>
                                                    <option value="Sandwiches & Wraps">Sandwiches & Wraps</option>
                                                    <option value="Pizza">Pizza</option>
                                                    <option value="Pasta">Pasta</option>
                                                    <option value="Borrito">Borrito</option>
                                                    <option value="Rice Dishes">Rice Dishes</option>
                                                    <option value="Egg Dishes & Toast">Egg Dishes & Toast</option>
                                                    <option value="Fries & Pancakes">Fries & Pancakes</option>
